<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="multiv" translate="label" sortOrder="100">
            <label>Multiv</label>
        </tab>
        <section id="multiv_frontend" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Frontend Authentication</label>
            <tab>multiv</tab>
            <resource>Multiv_FrontendEmail::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="frontend_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Customer Frontend Base URL</label>
                    <comment>Base URL for Customer reset links (e.g., http://multi.local). No trailing slash.</comment>
                </field>
                <field id="vendor_frontend_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Vendor Frontend Base URL</label>
                    <comment>Base URL for Vendor reset links (e.g., http://commerce.multi.local). No trailing slash.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
