<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_address">
        <column xsi:type="decimal" name="indiangst_amount" scale="2" precision="12" default="0.00" comment="Indian GST Total Amount"/>
        <column xsi:type="decimal" name="indiangst_base_amount" scale="2" precision="12" default="0.00" comment="Indian GST Base Total Amount"/>
        <column xsi:type="decimal" name="indiangst_cgst" scale="2" precision="12" default="0.00" comment="Indian GST CGST"/>
        <column xsi:type="decimal" name="indiangst_sgst" scale="2" precision="12" default="0.00" comment="Indian GST SGST"/>
        <column xsi:type="decimal" name="indiangst_igst" scale="2" precision="12" default="0.00" comment="Indian GST IGST"/>
    </table>

    <table name="quote_item">
        <column xsi:type="decimal" name="indiangst_cgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST CGST Amount"/>
        <column xsi:type="decimal" name="indiangst_sgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST SGST Amount"/>
        <column xsi:type="decimal" name="indiangst_igst_amount" scale="2" precision="12" default="0.00" comment="Indian GST IGST Amount"/>
        <column xsi:type="decimal" name="indiangst_percent" scale="2" precision="12" default="0.00" comment="Indian GST Percent"/>
    </table>

    <table name="sales_order_item">
        <column xsi:type="decimal" name="indiangst_cgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST CGST Amount"/>
        <column xsi:type="decimal" name="indiangst_sgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST SGST Amount"/>
        <column xsi:type="decimal" name="indiangst_igst_amount" scale="2" precision="12" default="0.00" comment="Indian GST IGST Amount"/>
        <column xsi:type="decimal" name="indiangst_percent" scale="2" precision="12" default="0.00" comment="Indian GST Percent"/>
    </table>

    <table name="sales_order">
        <column xsi:type="decimal" name="indiangst_amount" scale="2" precision="12" default="0.00" comment="Indian GST Total Amount"/>
        <column xsi:type="decimal" name="indiangst_base_amount" scale="2" precision="12" default="0.00" comment="Indian GST Base Total Amount"/>
        <column xsi:type="decimal" name="indiangst_cgst" scale="2" precision="12" default="0.00" comment="Indian GST CGST"/>
        <column xsi:type="decimal" name="indiangst_sgst" scale="2" precision="12" default="0.00" comment="Indian GST SGST"/>
        <column xsi:type="decimal" name="indiangst_igst" scale="2" precision="12" default="0.00" comment="Indian GST IGST"/>
    </table>

    <!-- Vendor GST Profile Table -->
    <table name="tax_indiangst_vendor_profile" resource="default" engine="innodb" comment="Vendor GST Profile">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="vendor_code" nullable="false" length="255" comment="Unique Vendor Code/ID"/>
        <column xsi:type="varchar" name="gstin" nullable="true" length="15" comment="GST Identification Number"/>
        <column xsi:type="varchar" name="pan_number" nullable="true" length="10" comment="PAN Number"/>
        <column xsi:type="varchar" name="business_name" nullable="true" length="255" comment="Registered Business Name"/>
        <column xsi:type="int" name="region_id" padding="10" unsigned="true" nullable="true" comment="State/Region ID"/>
        <column xsi:type="varchar" name="postcode" nullable="true" length="20" comment="Pincode"/>
        <column xsi:type="boolean" name="is_registered" nullable="false" default="0" comment="Is GST Registered"/>
        <column xsi:type="decimal" name="turnover" scale="2" precision="12" default="0.00" comment="Annual Turnover"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNIQUE_VENDOR_CODE">
            <column name="vendor_code"/>
        </constraint>
    </table>

    <!-- Product Tax Code Table (like Amazon's tax codes) -->
    <table name="tax_indiangst_rate" resource="default" engine="innodb" comment="GST Product Tax Codes">
        <column xsi:type="int" name="rate_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Rate ID"/>
        <column xsi:type="varchar" name="tax_code" nullable="false" length="50" comment="Tax Code (e.g., GST_18, GST_28_CESS12)"/>
        <column xsi:type="varchar" name="tax_name" nullable="false" length="255" comment="Tax Name/Description"/>
        <column xsi:type="decimal" name="cgst_rate" scale="4" precision="12" default="0.0000" comment="CGST Rate %"/>
        <column xsi:type="decimal" name="sgst_rate" scale="4" precision="12" default="0.0000" comment="SGST Rate %"/>
        <column xsi:type="decimal" name="igst_rate" scale="4" precision="12" default="0.0000" comment="IGST Rate %"/>
        <column xsi:type="decimal" name="cess_rate" scale="4" precision="12" default="0.0000" comment="Cess Rate %"/>
        <column xsi:type="decimal" name="total_rate" scale="4" precision="12" default="0.0000" comment="Total Tax Rate %"/>
        <column xsi:type="text" name="description" nullable="true" comment="Detailed Description"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rate_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNIQUE_TAX_CODE">
            <column name="tax_code"/>
        </constraint>
        <index referenceId="IDX_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <!-- Product GST Rate Mapping (Optional if using native tax classes, but requested) -->
    <table name="tax_indiangst_rates" resource="default" engine="innodb" comment="GST Rates Configuration">
        <column xsi:type="int" name="rate_id" padding="10" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="smallint" name="tax_class_id" unsigned="true" nullable="false" comment="Magento Tax Class ID"/>
        <column xsi:type="decimal" name="cgst_percent" scale="4" precision="12" default="0.0000"/>
        <column xsi:type="decimal" name="sgst_percent" scale="4" precision="12" default="0.0000"/>
        <column xsi:type="decimal" name="igst_percent" scale="4" precision="12" default="0.0000"/>
        <column xsi:type="decimal" name="cess_percent" scale="4" precision="12" default="0.0000"/>
        <column xsi:type="text" name="hsn_code" nullable="true" comment="HSN/SAC Code"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rate_id"/>
        </constraint>
    </table>

    <!-- Order GST Breakup -->
    <table name="tax_indiangst_order_breakup" resource="default" engine="innodb" comment="Order GST Breakup Item-wise">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Magento Order ID"/>
        <column xsi:type="int" name="order_item_id" padding="10" unsigned="true" nullable="false" comment="Magento Order Item ID"/>
        <column xsi:type="int" name="vendor_id" padding="10" unsigned="true" nullable="true" comment="Vendor Profile ID"/>
        <column xsi:type="varchar" name="hsn_code" nullable="true" length="50"/>
        <column xsi:type="varchar" name="tax_type" nullable="true" length="10" comment="IGST or CGST_SGST"/>
        <column xsi:type="decimal" name="taxable_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="cgst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="sgst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="igst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="total_tax_amount" scale="4" precision="20" default="0.0000"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="IDX_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>

    <table name="sales_invoice">
        <column xsi:type="decimal" name="indiangst_amount" scale="2" precision="12" default="0.00" comment="Indian GST Total Amount"/>
        <column xsi:type="decimal" name="indiangst_base_amount" scale="2" precision="12" default="0.00" comment="Indian GST Base Total Amount"/>
        <column xsi:type="decimal" name="indiangst_cgst" scale="2" precision="12" default="0.00" comment="Indian GST CGST"/>
        <column xsi:type="decimal" name="indiangst_sgst" scale="2" precision="12" default="0.00" comment="Indian GST SGST"/>
        <column xsi:type="decimal" name="indiangst_igst" scale="2" precision="12" default="0.00" comment="Indian GST IGST"/>
    </table>

    <table name="sales_invoice_item">
         <column xsi:type="decimal" name="indiangst_cgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST CGST Amount"/>
        <column xsi:type="decimal" name="indiangst_sgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST SGST Amount"/>
        <column xsi:type="decimal" name="indiangst_igst_amount" scale="2" precision="12" default="0.00" comment="Indian GST IGST Amount"/>
        <column xsi:type="decimal" name="indiangst_percent" scale="2" precision="12" default="0.00" comment="Indian GST Percent"/>
    </table>

    <table name="sales_creditmemo">
        <column xsi:type="decimal" name="indiangst_amount" scale="2" precision="12" default="0.00" comment="Indian GST Total Amount"/>
        <column xsi:type="decimal" name="indiangst_base_amount" scale="2" precision="12" default="0.00" comment="Indian GST Base Total Amount"/>
        <column xsi:type="decimal" name="indiangst_cgst" scale="2" precision="12" default="0.00" comment="Indian GST CGST"/>
        <column xsi:type="decimal" name="indiangst_sgst" scale="2" precision="12" default="0.00" comment="Indian GST SGST"/>
        <column xsi:type="decimal" name="indiangst_igst" scale="2" precision="12" default="0.00" comment="Indian GST IGST"/>
    </table>

    <table name="sales_creditmemo_item">
         <column xsi:type="decimal" name="indiangst_cgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST CGST Amount"/>
        <column xsi:type="decimal" name="indiangst_sgst_amount" scale="2" precision="12" default="0.00" comment="Indian GST SGST Amount"/>
        <column xsi:type="decimal" name="indiangst_igst_amount" scale="2" precision="12" default="0.00" comment="Indian GST IGST Amount"/>
        <column xsi:type="decimal" name="indiangst_percent" scale="2" precision="12" default="0.00" comment="Indian GST Percent"/>
    </table>

    <!-- Commission GST Table -->
    <table name="tax_indiangst_vendor_commission" resource="default" engine="innodb" comment="GST on Vendor Commission">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Order ID"/>
        <column xsi:type="int" name="vendor_id" padding="10" unsigned="true" nullable="false" comment="Vendor ID"/>
        <column xsi:type="decimal" name="commission_amount" scale="4" precision="20" default="0.0000" comment="Base Commission"/>
        <column xsi:type="decimal" name="cgst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="sgst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="igst_amount" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="decimal" name="total_tax" scale="4" precision="20" default="0.0000"/>
        <column xsi:type="varchar" name="sac_code" nullable="false" length="20" default="9983"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>
