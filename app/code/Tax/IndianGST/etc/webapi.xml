<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Get Vendor Profile -->
    <route url="/V1/indiangst/vendor/:id" method="GET">
        <service class="Tax\IndianGST\Api\VendorRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Tax_IndianGST::vendors"/>
        </resources>
    </route>

    <!-- Save Vendor Profile -->
    <route url="/V1/indiangst/vendor" method="POST">
        <service class="Tax\IndianGST\Api\VendorRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Tax_IndianGST::vendors"/>
        </resources>
    </route>

    <!-- Get Order GST Breakup -->
    <route url="/V1/indiangst/orders/:orderId/breakup" method="GET">
        <service class="Tax\IndianGST\Api\OrderBreakupRepositoryInterface" method="getByOrderId"/>
        <resources>
            <resource ref="Tax_IndianGST::root"/>
        </resources>
    </route>
</routes>
