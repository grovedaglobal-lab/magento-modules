<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="items">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::email/items.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="sales.email.order.renderers.default">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::email/items/order/default.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="sales.email.order.renderers.simple">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::email/items/order/default.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="sales.email.order.renderers.configurable">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::email/items/order/default.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
