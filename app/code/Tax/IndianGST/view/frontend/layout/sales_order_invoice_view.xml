<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Override Items Table Template -->
        <referenceBlock name="invoice_items">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::order/invoice/items.phtml</argument>
            </action>
        </referenceBlock>

        <!-- Override Item Renderer Template -->
        <referenceBlock name="sales.order.invoice.renderers.default">
             <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::order/invoice/items/renderer/default.phtml</argument>
            </action>
        </referenceBlock>

         <!-- Add Totals -->
        <referenceBlock name="invoice_totals">
             <action method="setTemplate">
                <argument name="template" xsi:type="string">Tax_IndianGST::order/totals.phtml</argument>
            </action>
             <block class="Tax\IndianGST\Block\Order\Invoice\Totals\Gst" name="indiangst.frontend.invoice.totals"/>
        </referenceBlock>
    </body>
</page>
