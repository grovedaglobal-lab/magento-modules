<?php
/**
 * @var \Magento\Sales\Block\Order\Email\Items\DefaultItems $block
 */
$_item = $block->getItem();
$_order = $_item->getOrder();

// Extract GST data
$cgst = (float) $_item->getData('indiangst_cgst_amount');
$sgst = (float) $_item->getData('indiangst_sgst_amount');
$igst = (float) $_item->getData('indiangst_igst_amount');
$percent = (float) $_item->getData('indiangst_percent');

$cgstRate = ($cgst > 0) ? ($percent / 2) : 0;
$sgstRate = ($sgst > 0) ? ($percent / 2) : 0;
$igstRate = ($igst > 0) ? $percent : 0;

$hsn = $_item->getProduct()->getData('hsn_code');
$_marketplaceHelper = $this->helper(\Vendor\Marketplace\Helper\Data::class);
$_vendorName = $_marketplaceHelper->getVendorNameByProduct($_item->getProduct());
?>
<tr>
    <td class="item-info<?= ($block->getItemOptions() ? ' has-extra' : '') ?>">
        <p class="product-name"><?= $block->escapeHtml($_item->getName()) ?></p>
        <?php if ($_vendorName): ?>
            <p class="vendor-name" style="font-size: 12px; color: #666; margin: 0;">
                <?= $block->escapeHtml(__('Sold By')) ?>: <?= $block->escapeHtml($_vendorName) ?>
            </p>
        <?php endif; ?>
        <p class="sku"><?= $block->escapeHtml(__('SKU')) ?>: <?= $block->escapeHtml($block->getSku($_item)) ?></p>
        <?php if ($hsn): ?>
            <p class="hsn"><?= $block->escapeHtml(__('HSN Code')) ?>: <?= $block->escapeHtml($hsn) ?></p>
        <?php endif; ?>
        <?php if ($block->getItemOptions()): ?>
            <dl class="item-options">
                <?php foreach ($block->getItemOptions() as $option): ?>
                    <dt><strong><em><?= $block->escapeHtml($option['label']) ?></em></strong></dt>
                    <dd>
                        <?= /* @noEscape */ nl2br($block->escapeHtml($option['value'])) ?>
                    </dd>
                <?php endforeach; ?>
            </dl>
        <?php endif; ?>
        <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
        <?php if ($addInfoBlock): ?>
            <?= $addInfoBlock->setItem($_item)->toHtml() ?>
        <?php endif; ?>
        <?= $block->escapeHtml($_item->getDescription()) ?>
    </td>

    <!-- GST Columns -->
    <td class="item-gst-cgst" style="text-align: center;">
        <?php if ($cgst > 0): ?>
            <?= $cgstRate ?>% <?= $_order->formatPrice($cgst) ?>
        <?php else: ?>
            0.00% <?= $_order->formatPrice(0) ?>
        <?php endif; ?>
    </td>
    <td class="item-gst-sgst" style="text-align: center;">
        <?php if ($sgst > 0): ?>
            <?= $sgstRate ?>% <?= $_order->formatPrice($sgst) ?>
        <?php else: ?>
            0.00% <?= $_order->formatPrice(0) ?>
        <?php endif; ?>
    </td>
    <td class="item-gst-igst" style="text-align: center;">
        <?php if ($igst > 0): ?>
            <?= $igstRate ?>% <?= $_order->formatPrice($igst) ?>
        <?php else: ?>
            0.00% <?= $_order->formatPrice(0) ?>
        <?php endif; ?>
    </td>

    <td class="item-qty"><?= (float) $_item->getQtyOrdered() ?></td>
    <td class="item-price">
        <?= $block->getItemPrice($_item) ?>
    </td>
</tr>
<?php if ($_item->getGiftMessageId() && $_giftMessage = $this->helper(\Magento\GiftMessage\Helper\Message::class)->getGiftMessage($_item->getGiftMessageId())): ?>
    <tr>
        <td colspan="6" class="item-extra">
            <table class="message-gift">
                <tr>
                    <td>
                        <h3><?= $block->escapeHtml(__('Gift Message')) ?></h3>
                        <strong><?= $block->escapeHtml(__('From:')) ?></strong>
                        <?= $block->escapeHtml($_giftMessage->getSender()) ?>
                        <br /><strong><?= $block->escapeHtml(__('To:')) ?></strong>
                        <?= $block->escapeHtml($_giftMessage->getRecipient()) ?>
                        <br /><strong><?= $block->escapeHtml(__('Message:')) ?></strong>
                        <br /><?= $block->escapeHtml($_giftMessage->getMessage()) ?>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
<?php endif; ?>