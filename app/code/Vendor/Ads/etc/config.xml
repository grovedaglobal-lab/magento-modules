<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <vendor_ads_wallet_recharge>
                <active>1</active>
                <model>Vendor\Ads\Model\Payment\WalletRecharge</model>
                <title>Wallet Recharge (Internal)</title>
                <order_status>pending</order_status>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </vendor_ads_wallet_recharge>
        </payment>
        <vendor_ads>
            <general>
                <enabled>1</enabled>
                <max_sponsored>3</max_sponsored>
                <max_bids_per_vendor>50</max_bids_per_vendor>
                <aggregate_report_daily_schedule>* * * * *</aggregate_report_daily_schedule>
            </general>
            <vendor_integration>
                <vendor_module>custom_marketplace</vendor_module>
                <vendor_table>vendor_entity</vendor_table>
                <vendor_id_column>entity_id</vendor_id_column>
                <vendor_name_column>name</vendor_name_column>
                <customer_id_column>customer_id</customer_id_column>
            </vendor_integration>
            <cpc>
                <min_bid>0.01</min_bid>
                <default_currency>USD</default_currency>
            </cpc>
            <wallet_recharge>
                <recharge_product_sku>wallet-recharge</recharge_product_sku>
                <gst_tax_class_id>0</gst_tax_class_id>
                <tax_mode>exclusive</tax_mode>
            </wallet_recharge>
        </vendor_ads>
        <cron>
            <vendor_ads>
                <schedule_generate_every>1</schedule_generate_every>
                <schedule_ahead_for>20</schedule_ahead_for>
                <schedule_lifetime>15</schedule_lifetime>
                <history_cleanup_every>10</history_cleanup_every>
                <history_success_lifetime>60</history_success_lifetime>
                <history_failure_lifetime>4320</history_failure_lifetime>
                <use_separate_process>1</use_separate_process>
            </vendor_ads>
        </cron>
    </default>
</config>
