<?php
/** @var \Vendor\Ads\Block\Adminhtml\Bid\Grid $block */
$bids = $block->getBidData();
?>
<div class="vendor-ads-admin">
    <h2><?= __('Manage Bids - All Vendors') ?></h2>
    <p style="color:#666;"><?= __('Bids are linked to vendors via vendor_entity. Each row shows the vendor name, keyword, and bid configuration.') ?></p>

    <?php if (empty($bids)): ?>
        <div class="message message-notice"><span><?= __('No bids found.') ?></span></div>
    <?php else: ?>
    <table class="data-grid admin__table-primary">
        <thead>
            <tr>
                <th><?= __('Bid ID') ?></th>
                <th><?= __('Version') ?></th>
                <th><?= __('Vendor') ?></th>
                <th><?= __('Product ID') ?></th>
                <th><?= __('Keyword') ?></th>
                <th><?= __('CPC Bid') ?></th>
                <th><?= __('Match Type') ?></th>
                <th><?= __('Daily Budget') ?></th>
                <th><?= __('Total Budget') ?></th>
                <th><?= __('Spent') ?></th>
                <th><?= __('Start Date') ?></th>
                <th><?= __('End Date') ?></th>
                <th><?= __('Status') ?></th>
                <th><?= __('Created') ?></th>
                <th><?= __('History') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($bids as $bid): ?>
            <tr class="<?= $bid['is_active'] ? '' : '_disabled' ?>">
                <td><?= (int)$bid['bid_id'] ?></td>
                <td style="text-align:center;">
                    <?php $ver = (int)($bid['version'] ?? 1); ?>
                    <span style="font-weight:700;color:<?= $ver > 1 ? '#007bdb' : '#999' ?>;">v<?= $ver ?></span>
                </td>
                <td>
                    <strong><?= $block->escapeHtml($bid['vendor_name'] ?? 'N/A') ?></strong>
                    <small style="display:block;color:#999;">ID: <?= (int)$bid['vendor_id'] ?></small>
                </td>
                <td><?= (int)$bid['product_id'] ?></td>
                <td><code><?= $block->escapeHtml($bid['keyword'] ?? '-') ?></code></td>
                <td><?= number_format($bid['bid_amount'], 4) ?></td>
                <td><?= $block->escapeHtml(ucfirst($bid['match_type'])) ?></td>
                <td><?= $bid['daily_budget'] ? number_format($bid['daily_budget'], 2) : '-' ?></td>
                <td><?= $bid['total_budget'] ? number_format($bid['total_budget'], 2) : '-' ?></td>
                <td><?= number_format($bid['spent_amount'], 4) ?></td>
                <td><?= $bid['start_date'] ?: '-' ?></td>
                <td><?= $bid['end_date'] ?: '-' ?></td>
                <td>
                    <?php if ($bid['is_active']): ?>
                        <span style="color:green;font-weight:bold;"><?= __('Active') ?></span>
                    <?php else: ?>
                        <span style="color:red;"><?= __('Inactive') ?></span>
                    <?php endif; ?>
                </td>
                <td><?= $block->escapeHtml($bid['created_at']) ?></td>
                <td>
                    <?php if ($block->hasVersionHistory($bid)): ?>
                        <a href="<?= $block->escapeUrl($block->getVersionHistoryUrl($bid)) ?>"
                           style="color:#007bdb;font-weight:600;font-size:12px;"
                           title="<?= $block->escapeHtmlAttr(__('View full version history for this ad')) ?>">
                            📋 <?= $block->escapeHtml(__('History')) ?>
                        </a>
                    <?php else: ?>
                        <span style="color:#ccc;font-size:11px;">v1 only</span>
                    <?php endif; ?>
                </td>
            </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
    <?php endif; ?>
</div>
