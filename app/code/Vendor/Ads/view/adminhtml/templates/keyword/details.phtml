<!-- Comparison Modal -->
<div id="versionCompareModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:8px;padding:28px;max-width:700px;width:95%;max-height:90vh;overflow-y:auto;position:relative;">
        <button id="closeCompareModal" style="position:absolute;top:12px;right:16px;font-size:20px;background:none;border:none;cursor:pointer;">✕</button>
        <h3 id="compareModalTitle" style="margin-top:0;font-size:16px;font-weight:700;color:#333;"></h3>
        <div id="compareModalBody"></div>
    </div>
</div>

<script>
require(['jquery'], function ($) {
    'use strict';
    var compareUrl = '<?= $block->escapeJs($block->getCompareUrl()) ?>';

    $(document).on('click', '.btn-compare', function () {
        var bidA = $(this).data('bid-a'), bidB = $(this).data('bid-b');
        $('#compareModalTitle').text('Comparing ' + $(this).data('label-a') + ' → ' + $(this).data('label-b'));
        $('#compareModalBody').html('<p style="text-align:center;padding:20px;">Loading...</p>');
        $('#versionCompareModal').css('display', 'flex');

        $.ajax({
            url: compareUrl,
            data: { bid_id_a: bidA, bid_id_b: bidB },
            dataType: 'json',
            success: function (res) {
                if (!res.success) { $('#compareModalBody').html('<p style="color:red;">' + res.message + '</p>'); return; }
                var html = '<table class="data-grid admin__table-primary" style="width:100%;">';
                html += '<thead><tr><th>Field</th><th>' + res.version_a + '</th><th>' + res.version_b + '</th><th>Change</th></tr></thead><tbody>';
                $.each(res.diff, function (i, row) {
                    var rowStyle = row.changed ? 'background:#fffbe6;' : '';
                    var changeCell = row.changed ? (row.pct_change ? (row.pct_change > 0 ? '+' : '') + row.pct_change + '%' : 'Changed') : '—';
                    html += '<tr style="' + rowStyle + '"><td><strong>' + row.field + '</strong></td><td>' + row.value_a + '</td><td><strong>' + row.value_b + '</strong></td><td>' + changeCell + '</td></tr>';
                });
                html += '</tbody></table>';
                $('#compareModalBody').html(html);
            }
        });
    });
    $('#closeCompareModal, #versionCompareModal').on('click', function(e) { if (e.target === this) $('#versionCompareModal').hide(); });
});
</script>

