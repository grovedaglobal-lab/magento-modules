<?php foreach ($_invoices as $_invoice): ?>
    <?php $_order = $_invoice->getOrder(); ?>
    <?php
    // In Wallet Replenishment, the "Vendor" is always the Marketplace Admin
    $vendorData = null;
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    
    $scopeConfig = $objectManager->get(\Magento\Framework\App\Config\ScopeConfigInterface::class);
    $adminName = $scopeConfig->getValue('general/store_information/name', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminStreet = $scopeConfig->getValue('general/store_information/street_line1', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminCity = $scopeConfig->getValue('general/store_information/city', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    
    $regionId = $scopeConfig->getValue('general/store_information/region_id', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminState = '';
    if ($regionId) {
        $regionModel = $objectManager->create(\Magento\Directory\Model\Region::class)->load($regionId);
        $adminState = $regionModel->getName();
    }
    
    $adminZip = $scopeConfig->getValue('general/store_information/postcode', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminCountry = $scopeConfig->getValue('general/store_information/country_id', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminGst = $scopeConfig->getValue('tax_indiangst/general/gstin', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    // Fallback to native VAT field if the custom GST module field is empty or just dummy test data
    if (!$adminGst || strlen(trim($adminGst)) < 15) {
        $adminGst = $scopeConfig->getValue('general/store_information/merchant_vat_number', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    }
    
    $adminPan = '';
    // A valid Indian GSTIN is exactly 15 characters, where characters 3 through 12 form the PAN
    if ($adminGst && strlen(trim($adminGst)) >= 15) {
        $adminPan = substr(trim($adminGst), 2, 10);
    }
    
    // Read admin signature & authorized name from config
    $adminSignatureFile = $scopeConfig->getValue('vendor_ads/wallet_recharge/signature_image', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
    $adminAuthorizedName = $scopeConfig->getValue('vendor_ads/wallet_recharge/authorized_signatory', \Magento\Store\Model\ScopeInterface::SCOPE_STORE)
                           ?: ($adminName ?: __('Marketplace Admin'));

    $vendorData = [
        'business_name'    => $adminName ?: __('Marketplace Admin'),
        'shop_name'        => $adminName ?: __('Marketplace Admin'),
        'address'          => $adminStreet,
        'city'             => $adminCity,
        'state'            => $adminState,
        'zip_code'         => $adminZip,
        'country'          => $adminCountry,
        'pan_number'       => $adminPan,
        'gstin'            => $adminGst,
        'signature'        => $adminSignatureFile,
        'authorized_name'  => $adminAuthorizedName
    ];
    ?>
    <div class="invoice-container">
        <!-- HEADER -->
        <div class="header-row">
            <div class="logo-area">
                <?php
                // Render admin Indian GST logo first, fallback to store logo if needed
                try {
                    $logoUrl = null;
                    $logoAlt = '';
                    $logoWidth = null;
                    $logoHeight = null;
                    $adminLogo = $scopeConfig->getValue('tax_indiangst/general/admin_logo', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);

                    if ($adminLogo) {
                        $storeManager = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class);
                        $mediaBaseUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
                        $logoPath = 'tax/indiangst/admin_logo/' . ltrim($adminLogo, '/');
                        $logoUrl = $mediaBaseUrl . $logoPath;
                        $logoAlt = __('Admin Invoice Logo');
                    } else {
                        $logoBlock = $this->getLayout()->createBlock(\Magento\Theme\Block\Html\Header\Logo::class);
                        if ($logoBlock) {
                            $logoSrc = $logoBlock->getLogoSrc();
                            $logoAlt = $logoBlock->getLogoAlt();
                            $logoWidth = $logoBlock->getLogoWidth();
                            $logoHeight = $logoBlock->getLogoHeight();
                            if ($logoSrc) {
                                if (strpos($logoSrc, 'http') === 0) {
                                    $logoUrl = $logoSrc;
                                } else {
                                    $base = method_exists($block, 'getBaseUrl') ? $block->getBaseUrl() : $this->getUrl('');
                                    $logoUrl = rtrim($base, '/') . '/' . ltrim($logoSrc, '/');
                                }
                            }
                        }
                    }

                    if ($logoUrl) {
                        ?>
                        <img src="<?= $block->escapeUrl($logoUrl) ?>"
                             title="<?= $block->escapeHtmlAttr($logoAlt) ?>"
                             alt="<?= $block->escapeHtmlAttr($logoAlt) ?>"
                             <?= $logoWidth ? 'width="' . $block->escapeHtmlAttr($logoWidth) . '"' : '' ?>
                             <?= $logoHeight ? 'height="' . $block->escapeHtmlAttr($logoHeight) . '"' : '' ?>
                        />
                    <?php }
                } catch (\Exception $e) {
                    // Fallback: nothing — invoice will show without logo if retrieval fails
                }
                ?>
            </div>
            <div class="title-area">
                <div class="invoice-title"><?= __('Tax Invoice/Bill of Supply/Cash Memo') ?></div>
                <div class="invoice-subtitle">(<?= __('Original for Recipient') ?>)</div>
            </div>
        </div>

        <!-- ADDRESSES (2 Columns) -->
        <div class="address-section" style="border-bottom: 1px solid #ddd; margin-bottom: 10px; padding-bottom: 5px;">
            <div class="col-left">
                <span class="section-header"><?= __('Sold By :') ?></span>
                <?php if ($vendorData): ?>
                    <div class="address-block">
                        <strong><?= $block->escapeHtml($vendorData['business_name'] ?: $vendorData['shop_name']) ?></strong><br>
                        <?= $block->escapeHtml($vendorData['address']) ?><br>
                        <?= $block->escapeHtml($vendorData['city']) ?>, <?= $block->escapeHtml($vendorData['state']) ?> -
                        <?= $block->escapeHtml($vendorData['zip_code']) ?><br>
                        <?= $block->escapeHtml($vendorData['country'] ?: __('India')) ?>
                    </div>
                    <div class="tax-info">
                        <?php if (!empty($vendorData['pan_number'])): ?>
                            <strong><?= __('PAN No:') ?></strong> <?= $block->escapeHtml($vendorData['pan_number']) ?><br>
                        <?php endif; ?>
                        <?php if (!empty($vendorData['gstin'])): ?>
                            <strong><?= __('GST Registration No:') ?></strong> <?= $block->escapeHtml($vendorData['gstin']) ?><br>
                        <?php endif; ?>
                        <br/>
                    </div>
                <?php else: ?>
                    <strong><?= __('Default Seller / Admin') ?></strong>
                <?php endif; ?>
            </div>

            <div class="col-right">
                <div class="address-block">
                    <span class="section-header"><?= __('Billing Address :') ?></span>
                    <?php $_billing = $_invoice->getbillingAddress() ?>
                    <address><?= /* @noEscape */ $block->formatAddress($_order->getBillingAddress(), 'html') ?></address>
                    <strong><?= __('State/UT Code:') ?></strong> <?= $_billing->getRegionId() ?>
                </div>
                <div class="address-block">
                    <span class="section-header"><?= __('Shipping Address :') ?></span>
                    <?php if (!$_order->getIsVirtual()): ?>
                        <?php $_shipping = $_invoice->getShippingAddress() ?>
                        <address><?= /* @noEscape */ $block->formatAddress($_shipping, 'html') ?></address>
                        <strong><?= __('Place of supply:') ?></strong> <?= $_shipping->getRegion() ?><br>
                        <strong><?= __('Place of delivery:') ?></strong> <?= $_shipping->getRegion() ?>
                    <?php else: ?>
                        <?= __('N/A') ?>
                    <?php endif; ?>
                </div>
            </div>
        </div>

        <!-- ORDER DETAILS BAND -->
        <div class="order-details-band">
            <div>
                <strong><?= __('Order Number:') ?></strong> <?= $block->escapeHtml($_order->getIncrementId()) ?><br>
                <strong><?= __('Order Date:') ?></strong>
                <?= $block->formatDate($_order->getCreatedAt(), \IntlDateFormatter::SHORT, false) ?>
            </div>
            <div class="text-right">
                <strong><?= __('Invoice ID :') ?></strong> #<?= $block->escapeHtml($_invoice->getIncrementId()) ?><br>
                <strong><?= __('Invoice Details :') ?></strong> <?= __('GJ-%1', $_invoice->getIncrementId()) ?><br>
                <strong><?= __('Invoice Date :') ?></strong>
                <?= $block->formatDate($_invoice->getCreatedAt(), \IntlDateFormatter::SHORT, false) ?>
            </div>
        </div>

        <!-- TABLE -->
        <table class="invoice-table">
            <thead>
                <tr>
                    <th width="3%">Sl. No</th>
                    <th width="35%">Description</th>
                    <th width="8%">Unit Price</th>
                    <th width="5%">Qty</th>
                    <th width="10%">Net Amount</th>
                    <th width="7%">CGST</th>
                    <th width="7%">SGST</th>
                    <th width="7%">IGST</th>
                    <th width="10%">Total Amount</th>
                </tr>
            </thead>
            <?php
            $totalCGST = 0;
            $totalSGST = 0;
            $totalIGST = 0;
            foreach ($_invoice->getAllItems() as $_item) {
                if (!$_item->getOrderItem()->getParentItem()) {
                    $totalCGST += (float) $_item->getData('indiangst_cgst_amount');
                    $totalSGST += (float) $_item->getData('indiangst_sgst_amount');
                    $totalIGST += (float) $_item->getData('indiangst_igst_amount');
                }
            }
            ?>
            <?php foreach ($_invoice->getAllItems() as $_item): ?>
                <?php if (!$_item->getOrderItem()->getParentItem()): ?>
                    <tbody>
                        <?= $block->getItemHtml($_item) ?>
                    </tbody>
                <?php endif; ?>
            <?php endforeach; ?>
            <!-- TOTAL ROW -->
            <!-- TOTALS -->
            <tfoot>
                <!-- Subtotal -->
                <tr>
                    <td colspan="4" class="text-right"><strong><?= __('Subtotal') ?></strong></td>
                    <td class="text-right"><?= $_order->formatPrice($_invoice->getSubtotal()) ?></td>
                </tr>

                <!-- Taxes Breakdown -->
                <?php if ($totalCGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('CGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalCGST) ?></td>
                    </tr>
                <?php endif; ?>

                <?php if ($totalSGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('SGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalSGST) ?></td>
                    </tr>
                <?php endif; ?>

                <?php if ($totalIGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('IGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalIGST) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Fallback: If no specific GST data found but there is tax amount (e.g. legacy/other tax) -->
                <?php if ($totalCGST == 0 && $totalSGST == 0 && $totalIGST == 0 && $_invoice->getTaxAmount() > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Tax Amount') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getTaxAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Shipping -->
                <?php if ($_invoice->getShippingAmount() > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Shipping Charge') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getShippingAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Discount -->
                <?php if ($_invoice->getDiscountAmount() < 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Discount') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getDiscountAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <?php
                // Recalculate Grand Total based on displayed components
                $calculatedGrandTotal = $_invoice->getSubtotal()
                    + $_invoice->getShippingAmount()
                    + $_invoice->getDiscountAmount();

                if ($totalCGST > 0 || $totalSGST > 0 || $totalIGST > 0) {
                    $calculatedGrandTotal += $totalCGST + $totalSGST + $totalIGST;
                } else if ($_invoice->getTaxAmount() > 0) {
                    $calculatedGrandTotal += $_invoice->getTaxAmount();
                }

                // stored grand total might be wrong (missing tax)
                // So we prefer the calculated total.
            
                // Logic: Round the calculated total to nearest integer to get "Target Total"
                // Then difference is Round Off.
                $targetGrandTotal = round($calculatedGrandTotal);

                // If the stored grand total is correct (matches calculated within small margin), use it.
                // But here we know stored is 666.67 and calculated is 700.01.
            
                // Use explicit rounding to 2 decimals to avoid floating point weirdness
                $roundOffArgs = round($targetGrandTotal - $calculatedGrandTotal, 2);

                // Final display should be the Target (Rounded) Total
                $finalGrandTotal = $targetGrandTotal;
                ?>

                <!-- Round Off Row -->
                <?php if (abs($roundOffArgs) >= 0.01): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Round Off') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($roundOffArgs) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Grand Total -->
                <tr class="grand-total">
                    <td colspan="8" class="text-right"><strong><?= __('Grand Total') ?></strong></td>
                    <td class="text-right" style="background: #ddd; font-weight: bold;">
                        <?= $_order->formatPrice($finalGrandTotal) ?>
                    </td>
                </tr>
            </tfoot>
        </table>

        <!-- FOOTER -->
        <div class="footer-section">
            <div class="amount-words-row">
                <?= __('Amount in Words:') ?><br>
                <?= $gstHelper->amountToWords($finalGrandTotal) ?>
            </div>

            <div style="font-size: 9px; margin-bottom: 5px; font-style: italic;">
                <?= __('* Rounding off is applicable as per Section 170 of CGST Act, 2017.') ?>
            </div>

            <div style="text-align: right;">
                <strong><?= __('For %1', $vendorData ? $vendorData['business_name'] : 'Confirmed Seller') ?>:</strong>
                <div class="signatory-block">
                    <?php if ($vendorData && !empty($vendorData['signature'])): ?>
                        <?php
                        $mediaUrl = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class)
                            ->getStore()
                            ->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
                        $signatureUrl = $mediaUrl . 'vendor_ads/signature/' . ltrim($vendorData['signature'], '/');
                        ?>
                        <img src="<?= $signatureUrl ?>" alt="Signature" style="max-height: 50px; margin-bottom: 5px;"><br>
                    <?php else: ?>
                        <br><br>
                    <?php endif; ?>
                    <strong><?= __('Authorized Signatory') ?></strong>
                    <?php if ($vendorData && !empty($vendorData['authorized_name'])): ?>
                        <br><span><?= $block->escapeHtml($vendorData['authorized_name']) ?></span>
                    <?php endif; ?>
                </div>
            </div>
        </div>
        <div class="reverse-charge">
            <?= __('Whether tax is payable under reverse charge - No') ?>
        </div>
    </div>
<?php endforeach; ?>