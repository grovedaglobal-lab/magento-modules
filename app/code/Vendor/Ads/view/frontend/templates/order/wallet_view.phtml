<?php
/** @var \Vendor\Marketplace\Block\Order\View $block */
/** @var \Magento\Framework\Escaper $escaper */
try {
    $vendorOrder = $block->getVendorOrder();
    $order = $block->getOrder();
} catch (\Exception $e) {
    return;
}

if (!$vendorOrder || !$order) {
    echo '<div class="message error">Order not found or you do not have permission to view this order.</div>';
    return;
}

// Use block properties/methods where available
$priceHelper = $this->helper(\Magento\Framework\Pricing\Helper\Data::class);
$scopeConfig = $block->getData('scopeConfig') ?: \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Framework\App\Config\ScopeConfigInterface::class);

// Admin / Seller Details
$adminName = $scopeConfig->getValue('general/store_information/name', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$adminStreet = $scopeConfig->getValue('general/store_information/street_line1', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$adminCity = $scopeConfig->getValue('general/store_information/city', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$adminZip = $scopeConfig->getValue('general/store_information/postcode', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);

// Match Admin GST extraction logic from invoice.phtml
$adminGst = $scopeConfig->getValue('tax_indiangst/general/gstin', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
if (!$adminGst || strlen(trim($adminGst)) < 15) {
    $adminGst = $scopeConfig->getValue('general/store_information/merchant_vat_number', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
}

// Vendor / Buyer Details
$vendorId = (int)$vendorOrder->getVendorId();
$resource = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Framework\App\ResourceConnection::class);
$connection = $resource->getConnection();
$profileTable = $resource->getTableName('vendor_profile');
$gstTable = $resource->getTableName('tax_indiangst_vendor_profile');

$select = $connection->select()
    ->from(['vp' => $profileTable], ['shop_name', 'company_name', 'address', 'city', 'state', 'zip_code', 'country', 'email', 'phone'])
    ->joinLeft(['gst' => $gstTable], 'vp.vendor_id = gst.vendor_code', ['gstin', 'pan_number', 'vendor_business_name' => 'business_name'])
    ->where('vp.vendor_id = ?', $vendorId);
$vendorInfo = $connection->fetchRow($select);

// Payment Method Mapping
$payment = $order->getPayment();
$methodTitle = $payment->getMethodInstance()->getTitle();
if ($payment->getMethod() == 'vendor_ads_wallet_recharge') {
    $methodTitle = __('Razorpay (Digital Payment)');
}

// Razorpay Transaction ID Fallback
$razorpayPaymentId = ($order->getPayment()) ? $order->getPayment()->getData('last_trans_id') : null;
if (!$razorpayPaymentId) {
    $payTable = $resource->getTableName('vendor_ads_payment');
    $razorpayPaymentId = $connection->fetchOne(
        $connection->select()->from($payTable, 'razorpay_payment_id')->where('magento_order_id = ?', $order->getId())
    );
}
?>

