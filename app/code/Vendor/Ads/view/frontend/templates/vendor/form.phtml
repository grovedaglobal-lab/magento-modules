<script>
(function() {
    var WALLET_BALANCE = <?= (float)$walletBalance ?>;
    var KW_SUGGEST_URL = '<?= $escaper->escapeUrl($block->getKeywordSuggestUrl()) ?>';
    var BID_SUGGEST_URL = '<?= $escaper->escapeUrl($block->getBidSuggestUrl()) ?>';
    var bidIntelData = {};
    var suggestTimeout;

    // ═══════════════════════════════════════════
    // GROUP + CAMPAIGN HIERARCHY LOGIC
    // ═══════════════════════════════════════════

    var GROUPS_DATA = <?= json_encode(array_map(fn($g) => [
        'id'        => $g['id'],
        'name'      => $g['name'],
        'campaigns' => array_map(fn($c) => ['id' => $c['id'], 'name' => $c['name']], $g['campaigns'])
    ], $groups)) ?>;

    function updateBreadcrumb() {
        var groupName = '— not set —';
        var campaignName = '— not set —';

        var groupMode = document.querySelector('[name=group_mode]:checked');
        if (groupMode) {
            if (groupMode.value === 'new_group') {
                var gn = document.getElementById('group_name');
                groupName = (gn && gn.value.trim()) ? gn.value.trim() : '(new group)';
            } else if (groupMode.value === 'existing_group') {
                var gs = document.getElementById('group_id');
                if (gs && gs.selectedIndex > 0) groupName = gs.options[gs.selectedIndex].text.split('(')[0].trim();
            } else {
                groupName = 'Standalone';
            }
        }

        var campaignMode = document.querySelector('[name=campaign_mode]:checked');
        if (campaignMode) {
            if (campaignMode.value === 'new') {
                var cn = document.getElementById('campaign_name');
                campaignName = (cn && cn.value.trim()) ? cn.value.trim() : '(new campaign)';
            } else {
                var cs = document.getElementById('campaign_id');
                if (cs && cs.selectedIndex > 0) campaignName = cs.options[cs.selectedIndex].text.split('(')[0].trim();
            }
        }

        var hbGroup = document.getElementById('hb-group-name');
        var hbCamp  = document.getElementById('hb-campaign-name');
        if (hbGroup)  hbGroup.textContent  = groupName;
        if (hbCamp)   hbCamp.textContent   = campaignName;
    }

    // ── Group mode radios ──
    document.querySelectorAll('[name=group_mode]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var mode = this.value;
            var newGroupForm    = document.getElementById('new-group-form');
            var existingGrpWrap = document.getElementById('existing-group-wrap');

            // Show/hide panels
            if (newGroupForm)    newGroupForm.classList.toggle('visible', mode === 'new_group');
            if (existingGrpWrap) existingGrpWrap.style.display = (mode === 'existing_group') ? '' : 'none';

            // Update radio card selection styling
            document.querySelectorAll('[name=group_mode]').forEach(function(r) {
                r.closest('.ads-radio-card').classList.remove('selected');
            });
            this.closest('.ads-radio-card').classList.add('selected');

            // Filter campaigns by group if existing selected
            if (mode === 'existing_group') {
                filterCampaignsByGroup();
            } else {
                showAllCampaigns();
            }

            updateBreadcrumb();
        });
    });

    // ── Existing group select → filter campaigns ──
    var groupSelect = document.getElementById('group_id');
    if (groupSelect) {
        groupSelect.addEventListener('change', function() {
            filterCampaignsByGroup();
            updateBreadcrumb();
        });
    }

    function filterCampaignsByGroup() {
        var gs = document.getElementById('group_id');
        var selectedGroupId = gs ? parseInt(gs.value) : 0;
        var campaignSel = document.getElementById('campaign_id');
        if (!campaignSel) return;

        Array.from(campaignSel.options).forEach(function(opt) {
            if (!opt.value) return; // keep placeholder
            var optGroup = parseInt(opt.dataset.group || 0);
            opt.hidden = (selectedGroupId > 0 && optGroup !== selectedGroupId);
        });
        updateBreadcrumb();
    }

    function showAllCampaigns() {
        var campaignSel = document.getElementById('campaign_id');
        if (!campaignSel) return;
        Array.from(campaignSel.options).forEach(function(opt) { opt.hidden = false; });
    }

    // ── Campaign mode radios ──
    document.querySelectorAll('[name=campaign_mode]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var isNew        = this.value === 'new';
            var newForm      = document.getElementById('new-campaign-form');
            var existingWrap = document.getElementById('existing-campaign-wrap');
            if (newForm)      newForm.classList.toggle('visible', isNew);
            if (existingWrap) existingWrap.style.display = isNew ? 'none' : '';

            document.querySelectorAll('[name=campaign_mode]').forEach(function(r) {
                r.closest('.ads-radio-card').classList.remove('selected');
            });
            this.closest('.ads-radio-card').classList.add('selected');
            updateBreadcrumb();
        });
    });

    // ── Live breadcrumb on typing campaign name / group name ──
    ['campaign_name','group_name'].forEach(function(fid) {
        var el = document.getElementById(fid);
        if (el) el.addEventListener('input', updateBreadcrumb);
    });
    var campSel = document.getElementById('campaign_id');
    if (campSel) campSel.addEventListener('change', updateBreadcrumb);

    // ── Targeting type toggle ──
    document.querySelectorAll('[name=targeting_type]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var section = document.getElementById('targeting-section');
            if (section) section.style.cssText = this.value === 'auto' ? 'opacity:.4;pointer-events:none' : '';
            document.querySelectorAll('[name=targeting_type]').forEach(function(r) {
                r.closest('.ads-radio-card').classList.remove('selected');
            });
            this.closest('.ads-radio-card').classList.add('selected');
        });
    });

    // Init breadcrumb
    updateBreadcrumb();



    // ═══════════════════════════════════════════
    // KEYWORD TARGETING PANEL
    // ═══════════════════════════════════════════

    var addedKeywords = []; // [{keyword, matchType, suggestedBid, bid}]
    var suggestedData  = []; // raw API results

    // ── Tab switching ──
    document.querySelectorAll('.kw-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.kw-tab').forEach(function(t) { t.classList.remove('active'); });
            this.classList.add('active');
            var id = this.dataset.tab;
            document.getElementById('tab-suggested').style.display  = id === 'suggested'  ? '' : 'none';
            document.getElementById('tab-enterlist').style.display   = id === 'enterlist'  ? '' : 'none';
        });
    });

    // ── Load popular suggested keywords on page load ──
    function loadSuggested() {
        fetch(KW_SUGGEST_URL + '?q=')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                suggestedData = data.suggestions || [];
                document.getElementById('sugg-count-badge').textContent = suggestedData.length;
                renderSuggestedRows();
            })
            .catch(function() {
                document.getElementById('suggested-rows').innerHTML = '<div class="kw-loading">No suggestions available.</div>';
            });
    }

    // ── Filter checkboxes ──
    document.querySelectorAll('.filter-mt').forEach(function(cb) {
        cb.addEventListener('change', renderSuggestedRows);
    });

    function getActiveFilters() {
        return Array.from(document.querySelectorAll('.filter-mt:checked')).map(function(cb) { return cb.value; });
    }

    function renderSuggestedRows() {
        var filters = getActiveFilters();
        var wrap = document.getElementById('suggested-rows');
        if (!suggestedData.length) {
            wrap.innerHTML = '<div class="kw-loading">No suggestions yet. Try entering a keyword below.</div>';
            return;
        }
        var html = '';
        var mtLabels = { broad: 'Broad', phrase: 'Phrase', exact: 'Exact' };
        var demandLabels = { high: '🔥 High', medium: '✅ Medium', low: '🔵 Low' };
        var demandColors = { high: '#8b3a00', medium: '#2d6a00', low: '#004a8b' };
        var demandBg     = { high: '#fff0e0', medium: '#e8f5e0', low: '#e0f0ff' };
        suggestedData.forEach(function(s) {
            ['broad', 'phrase', 'exact'].forEach(function(mt) {
                if (filters.indexOf(mt) === -1) return;
                var isAdded = addedKeywords.some(function(a) { return a.keyword === s.label && a.matchType === mt; });
                var sugBid = s.suggestedBid ? '₹' + parseFloat(s.suggestedBid).toFixed(2) : '—';
                var sugRange = s.bidMin && s.bidMax ? '₹' + parseFloat(s.bidMin).toFixed(2) + ' – ₹' + parseFloat(s.bidMax).toFixed(2) : '';
                var demand = s.demand || 'low';
                var popHtml = s.popularity > 0
                    ? '<span style="font-size:10px;color:#888;margin-left:4px;">Used ' + s.popularity + '×</span>'
                    : '';
                var demandHtml = '<span style="display:inline-block;font-size:10px;font-weight:700;padding:1px 6px;border-radius:8px;'
                    + 'background:' + (demandBg[demand] || '#f5f5f5') + ';color:' + (demandColors[demand] || '#555') + ';margin-left:4px;">'
                    + (demandLabels[demand] || demand) + '</span>';
                html += '<div class="kw-row" data-kw="' + esc(s.label) + '" data-mt="' + mt + '">' +
                    '<div class="kw-name" title="' + esc(s.label) + '">' + esc(s.label) + demandHtml + popHtml + '</div>' +
                    '<div class="kw-mt"><span class="mt-badge mt-' + mt + '">' + mtLabels[mt] + '</span></div>' +
                    '<div class="kw-sugg"><strong>' + sugBid + '</strong><small>' + sugRange + '</small></div>' +
                    '<div><button type="button" class="btn-add-kw' + (isAdded ? ' is-added' : '') + '" data-kw="' + esc(s.label) + '" data-mt="' + mt + '" data-bid="' + (s.suggestedBid || '0.50') + '">' +
                    (isAdded ? 'Added' : 'Add') + '</button></div>' +
                    '</div>';
            });
        });
        wrap.innerHTML = html || '<div class="kw-loading">No keywords match the selected filters.</div>';

        // Attach add-btn listeners
        wrap.querySelectorAll('.btn-add-kw:not(.is-added)').forEach(function(btn) {
            btn.addEventListener('click', function() {
                addKeyword(this.dataset.kw, this.dataset.mt, parseFloat(this.dataset.bid) || 0.50, null);
            });
        });
    }

    // ── Add All ──
    document.getElementById('btn-add-all').addEventListener('click', function() {
        var filters = getActiveFilters();
        suggestedData.forEach(function(s) {
            filters.forEach(function(mt) {
                if (!addedKeywords.some(function(a) { return a.keyword === s.label && a.matchType === mt; })) {
                    addKeyword(s.label, mt, parseFloat(s.suggestedBid) || 0.50, null);
                }
            });
        });
    });

    // ── Enter list: Add Keywords ──
    document.getElementById('btn-add-list').addEventListener('click', function() {
        var text = document.getElementById('kw-enter-textarea').value;
        var defaultBid = parseFloat(document.getElementById('enter-default-bid').value) || 0.50;
        var mts = Array.from(document.querySelectorAll('.enter-mt:checked')).map(function(cb) { return cb.value; });
        if (!mts.length) { alert('Please select at least one match type.'); return; }

        var lines = text.split('\n').map(function(l) { return l.trim().toLowerCase(); }).filter(Boolean);
        if (!lines.length) { alert('Please enter at least one keyword.'); return; }

        lines.forEach(function(kw) {
            mts.forEach(function(mt) {
                if (!addedKeywords.some(function(a) { return a.keyword === kw && a.matchType === mt; })) {
                    addKeyword(kw, mt, defaultBid, null);
                }
            });
        });
        document.getElementById('kw-enter-textarea').value = '';
    });

    // ── Core: add a keyword ──
    function addKeyword(keyword, matchType, suggestedBid, customBid) {
        keyword = keyword.trim().toLowerCase();
        if (!keyword) return;
        var bid = customBid || suggestedBid || 0.50;
        addedKeywords.push({ keyword: keyword, matchType: matchType, suggestedBid: suggestedBid, bid: bid });
        renderAddedRows();
        renderSuggestedRows();
        updateHiddenInputs();
        updateEstimation();
    }

    // ── Remove keyword ──
    function removeKeyword(idx) {
        addedKeywords.splice(idx, 1);
        renderAddedRows();
        renderSuggestedRows();
        updateHiddenInputs();
        updateEstimation();
    }


    // ── Render added panel ──
    function renderAddedRows() {
        var wrap = document.getElementById('added-rows');
        var countEl = document.getElementById('kw-added-count');
        countEl.textContent = addedKeywords.length + ' added';

        if (!addedKeywords.length) {
            wrap.innerHTML = '<div class="kw-empty-state">No keywords added yet. Add from Suggested or Enter list.</div>';
            return;
        }

        var mtLabels = { broad: 'Broad', phrase: 'Phrase', exact: 'Exact' };
        var html = '';
        addedKeywords.forEach(function(item, idx) {
            var sugBid = item.suggestedBid ? '₹' + parseFloat(item.suggestedBid).toFixed(2) : '—';
            html += '<div class="kw-row added-row" data-idx="' + idx + '">' +
                '<div class="kw-name" title="' + esc(item.keyword) + '">' + esc(item.keyword) + '</div>' +
                '<div class="kw-mt"><span class="mt-badge mt-' + item.matchType + '">' + mtLabels[item.matchType] + '</span></div>' +
                '<div class="kw-sugg"><strong>' + sugBid + '</strong></div>' +
                '<div><div class="kw-bid-inp"><span>₹</span><input type="number" step="0.01" min="0.01" class="added-bid-inp" data-idx="' + idx + '" value="' + parseFloat(item.bid).toFixed(2) + '"></div></div>' +
                '<div><button type="button" class="btn-rm" data-idx="' + idx + '" title="Remove">×</button></div>' +
                '</div>';
        });
        wrap.innerHTML = html;

        // Bind remove
        wrap.querySelectorAll('.btn-rm').forEach(function(btn) {
            btn.addEventListener('click', function() { removeKeyword(parseInt(this.dataset.idx)); });
        });

        // Bind bid change
        wrap.querySelectorAll('.added-bid-inp').forEach(function(inp) {
            inp.addEventListener('change', function() {
                var i = parseInt(this.dataset.idx);
                addedKeywords[i].bid = parseFloat(this.value) || 0.50;
                updateHiddenInputs();
                updateEstimation();
            });
        });
    }

    // ── Apply all: apply first bid to all ──
    document.getElementById('apply-all-bid').addEventListener('click', function() {
        var firstBid = addedKeywords.length ? addedKeywords[0].bid : 0.50;
        var applyBid = parseFloat(prompt('Apply bid amount (₹) to all keywords:', firstBid));
        if (isNaN(applyBid) || applyBid <= 0) return;
        addedKeywords.forEach(function(item) { item.bid = applyBid; });
        renderAddedRows();
        updateHiddenInputs();
        updateEstimation();
    });

    // ── Generate hidden inputs for form submission ──
    function updateHiddenInputs() {
        var container = document.getElementById('kw-hidden-inputs');
        var html = '';
        addedKeywords.forEach(function(item, idx) {
            html += '<input type="hidden" name="keywords[' + idx + '][keyword]" value="' + esc(item.keyword) + '">';
            html += '<input type="hidden" name="keywords[' + idx + '][match_type]" value="' + esc(item.matchType) + '">';
            html += '<input type="hidden" name="keywords[' + idx + '][bid_amount]" value="' + parseFloat(item.bid).toFixed(2) + '">';
        });
        container.innerHTML = html;
    }

    function esc(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Fetch bid intelligence for the global bid-intel card ──
    function fetchBidIntelForKeyword(kw) {
        if (!kw) return;
        fetch(BID_SUGGEST_URL + '?keyword=' + encodeURIComponent(kw))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                bidIntelData = data;
                renderBidIntel(data);
                updateEstimation();
                // Enrich suggested data with bid info
                suggestedData.forEach(function(s) {
                    if (s.label === kw) {
                        s.suggestedBid = data.suggested;
                        s.bidMin = data.min;
                        s.bidMax = data.max;
                    }
                });
            });
    }

    function fmt(v) { return v ? '₹' + parseFloat(v).toFixed(2) : '—'; }

    function renderBidIntel(data) {
        var card = document.getElementById('bid-intel-card');
        if (!card) return;
        card.classList.add('visible');
        document.getElementById('bid-min').textContent = fmt(data.min);
        document.getElementById('bid-avg').textContent = fmt(data.avg);
        document.getElementById('bid-max').textContent = fmt(data.max);
        document.getElementById('bid-suggested').textContent = fmt(data.suggested);

        var badge = document.getElementById('comp-badge');
        var compMap = { low: ['comp-low','🟢 Low'], medium: ['comp-medium','🟡 Medium'], high: ['comp-high','🔴 High'] };
        var info = compMap[data.competition] || compMap.low;
        badge.className = 'competition-badge ' + info[0];
        badge.textContent = info[1] + ' Competition';

        var countText = document.getElementById('bid-count-text');
        countText.textContent = data.count + ' active bids on this keyword.';

        var sugBtn = document.getElementById('use-suggested-btn');
        sugBtn.style.display = data.suggested ? 'inline-block' : 'none';
        sugBtn.onclick = function() {
            document.getElementById('bid_amount').value = parseFloat(data.suggested).toFixed(2);
            updateEstimation();
        };
    }

    // ── Performance estimation (uses avg of keyword bids) ──
    var dailyInput  = document.getElementById('daily_budget');
    if (dailyInput){ dailyInput.addEventListener('input', updateEstimation); }

    function getAvgKeywordBid() {
        if (!addedKeywords.length) return 0;
        var total = addedKeywords.reduce(function(sum, k) { return sum + (parseFloat(k.bid) || 0); }, 0);
        return total / addedKeywords.length;
    }

    function updateEstimation() {
        var bid   = getAvgKeywordBid();
        var daily = parseFloat(dailyInput ? dailyInput.value : 0) || 0;
        var avgBid = bidIntelData.avg ? parseFloat(bidIntelData.avg) : bid;
        if (!avgBid) avgBid = bid;

        var impressions = bid > 0 && avgBid > 0 ? Math.round((bid / avgBid) * 1000) : 0;
        var ctr = 0.025;
        var clicks = Math.round(impressions * ctr);
        var spend  = clicks * bid;

        if (daily > 0 && spend > daily) { spend = daily; clicks = Math.round(daily / (bid || 1)); impressions = Math.round(clicks / ctr); }

        document.getElementById('est-impressions').textContent = impressions > 0 ? impressions.toLocaleString() : '—';
        document.getElementById('est-clicks').textContent      = clicks > 0 ? clicks.toLocaleString() : '—';
        document.getElementById('est-spend').textContent       = spend > 0 ? '₹' + spend.toFixed(2) : '—';
    }


    // ── Wallet budget validation ──
    function validateBudget() {
        var daily = parseFloat(dailyInput ? dailyInput.value : 0) || 0;
        var total = parseFloat(document.getElementById('total_budget') ? document.getElementById('total_budget').value : 0) || 0;
        var max   = Math.max(daily, total);
        var warn  = document.getElementById('wallet-warning');
        if (warn && max > 0 && max > WALLET_BALANCE) {
            warn.style.display = 'block';
        } else if (warn) {
            warn.style.display = 'none';
        }
    }
    if (dailyInput) dailyInput.addEventListener('input', validateBudget);
    var totalInput = document.getElementById('total_budget');
    if (totalInput) totalInput.addEventListener('input', validateBudget);

    // ── Form submit guard ──
    document.getElementById('ads-campaign-form').addEventListener('submit', function(e) {
        var targetingType = document.querySelector('[name=targeting_type]:checked');
        var isManual = !targetingType || targetingType.value === 'manual';
        if (isManual && addedKeywords.length === 0) {
            e.preventDefault();
            alert('<?= $escaper->escapeHtml(__('Please add at least one keyword for Manual Targeting.')) ?>');
            return;
        }
        var warn = document.getElementById('wallet-warning');
        if (warn && warn.style.display === 'block') {
            if (!confirm('<?= $escaper->escapeHtml(__('Your budget exceeds your wallet balance. Continue anyway?')) ?>')) {
                e.preventDefault();
            }
        }
    });

    // ── Init ──
    loadSuggested();
    updateEstimation();
})();
</script>


