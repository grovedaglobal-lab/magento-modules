<script>
(function () {
    'use strict';

    var TOGGLE_URL = '<?= $toggleStatusUrl ?>';
    var KW_URL     = '<?= $kwUrl ?>';
    var detailCache = {};

    /* ─── SEARCH ─── */
    var searchInput = document.getElementById('ads-search');
    if (searchInput) {
        searchInput.addEventListener('input', function () {
            adsApplyFilters();
        });
    }

    /* ─── FILTER ─── */
    window.adsApplyFilter = function () {
        adsToggleDropdown('filterMenu'); // close
        adsApplyFilters();
    };

    function adsApplyFilters() {
        var query      = (searchInput ? searchInput.value.toLowerCase().trim() : '');
        var filterEl   = document.querySelector('input[name="ads-filter-status"]:checked');
        var filterStatus = filterEl ? filterEl.value : 'all';
        var rows       = document.querySelectorAll('.ads-campaign-row');
        var visible    = 0;

        rows.forEach(function (row) {
            var name   = row.getAttribute('data-name') || '';
            var status = row.getAttribute('data-status');

            var nameMatch   = (query === '' || name.indexOf(query) !== -1);
            var statusMatch = (filterStatus === 'all' || status === filterStatus);

            if (nameMatch && statusMatch) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });

        var noResults = document.getElementById('ads-no-results');
        if (noResults) noResults.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';

        var totalCount = document.getElementById('adsTotalCount');
        if (totalCount) totalCount.textContent = 'Totals for ' + visible + ' Campaigns';
    }

    /* ─── SELECT ALL ─── */
    var selectAll = document.getElementById('ads-select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.ads-row-check').forEach(function (cb) {
                cb.checked = selectAll.checked;
            });
        });
    }

    /* ─── BULK ACTIONS ─── */
    window.adsBulkAction = function (action) {
        adsToggleDropdown('bulkMenu'); // close
        var checked = document.querySelectorAll('.ads-row-check:checked');
        if (checked.length === 0) {
            adsShowToast('<?= $block->escapeJs(__('Please select at least one campaign.')) ?>', 'warn');
            return;
        }
        var newStatus = (action === 'activate') ? 1 : 0;
        var ids = [];
        checked.forEach(function (cb) { ids.push(parseInt(cb.value, 10)); });

        // Toggle each sequentially (simple loop, small sets)
        ids.forEach(function (campaignId) {
            adsDoToggle(campaignId, newStatus, false);
        });
        adsShowToast(action === 'activate'
            ? '<?= $block->escapeJs(__('Selected campaigns activated.')) ?>'
            : '<?= $block->escapeJs(__('Selected campaigns paused.')) ?>', 'success');
    };

    /* ─── TOGGLE STATUS (individual checkbox) ─── */
    document.querySelectorAll('.toggle-status-cb').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var campaignId = parseInt(this.getAttribute('data-campaign-id'), 10);
            var newStatus  = this.checked ? 1 : 0;
            adsDoToggle(campaignId, newStatus, true);
        });
    });

    window.adsToggleSingle = function (campaignId, newStatus) {
        adsDoToggle(campaignId, newStatus, true);
        // Close the row menu
        document.querySelectorAll('.row-action-menu').forEach(function (m) { m.style.display = 'none'; });
    };

    function adsDoToggle(campaignId, newStatus, showToast) {
        var formData = new FormData();
        formData.append('campaign_id', campaignId);
        formData.append('status', newStatus);
        // Add form key for CSRF protection
        var formKeyEl = document.querySelector('input[name="form_key"]');
        if (formKeyEl) formData.append('form_key', formKeyEl.value);

        fetch(TOGGLE_URL, {
            method: 'POST',
            body: formData,
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                // Update row UI
                var row = document.querySelector('.ads-campaign-row[data-campaign-id="' + campaignId + '"]');
                if (row) {
                    row.setAttribute('data-status', newStatus);

                    // Update toggle checkbox
                    var cb = row.querySelector('.toggle-status-cb');
                    if (cb) cb.checked = (newStatus === 1);

                    // Update status text
                    var statusCell = row.querySelector('.col-status');
                    if (statusCell) {
                        if (!newStatus) {
                            statusCell.innerHTML = '<span class="status-val status-paused"><?= $block->escapeJs(__('Paused')) ?></span>';
                        } else {
                            statusCell.innerHTML = '<span class="status-val status-delivering"><?= $block->escapeJs(__('Delivering')) ?></span><div class="status-sub"><?= $block->escapeJs(__('Details')) ?> ⌵</div>';
                        }
                    }

                    // Update the row-menu action button text
                    var actionBtn = row.querySelector('.row-action-menu button');
                    if (actionBtn) {
                        actionBtn.textContent = newStatus ? '<?= $block->escapeJs(__('Pause')) ?>' : '<?= $block->escapeJs(__('Activate')) ?>';
                        actionBtn.setAttribute('onclick', 'adsToggleSingle(' + campaignId + ',' + (newStatus ? 0 : 1) + ')');
                    }
                }

                if (showToast) adsShowToast(data.message, 'success');
            } else {
                // Revert checkbox
                var cb2 = document.querySelector('.toggle-status-cb[data-campaign-id="' + campaignId + '"]');
                if (cb2) cb2.checked = !newStatus;
                if (showToast) adsShowToast(data.message || '<?= $block->escapeJs(__('An error occurred.')) ?>', 'error');
            }
        })
        .catch(function () {
            if (showToast) adsShowToast('<?= $block->escapeJs(__('Network error. Please try again.')) ?>', 'error');
        });
    }

    /* ─── COLUMN TOGGLE ─── */
    document.querySelectorAll('.col-toggle').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var colClass = this.getAttribute('data-col');
            var show     = this.checked;
            // Find column index
            var headers = document.querySelectorAll('#adsManagerTable thead th');
            var colIdx  = -1;
            headers.forEach(function (th, idx) {
                if (th.classList.contains(colClass)) colIdx = idx;
            });
            if (colIdx === -1) return;

            // Toggle header
            headers.forEach(function (th, idx) {
                if (idx === colIdx) th.style.display = show ? '' : 'none';
            });
            // Toggle all row cells at same index
            document.querySelectorAll('#adsManagerTable tbody tr, #adsManagerTable tfoot tr').forEach(function (row) {
                var cells = row.querySelectorAll('td, th');
                if (cells[colIdx]) cells[colIdx].style.display = show ? '' : 'none';
            });
        });
    });

    /* ─── ROW ACTION MENU (⋮) ─── */
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('row-menu')) {
            // Close all others
            document.querySelectorAll('.row-action-menu').forEach(function (m) { m.style.display = 'none'; });
            var menu = e.target.nextElementSibling;
            if (menu) menu.style.display = (menu.style.display === 'none') ? 'block' : 'none';
            e.stopPropagation();
        } else if (!e.target.closest('.row-action-wrap') && !e.target.closest('.toolbar-dropdown-wrap')) {
            // Close row menus and toolbar dropdowns
            document.querySelectorAll('.row-action-menu').forEach(function (m) { m.style.display = 'none'; });
            document.querySelectorAll('.toolbar-dropdown').forEach(function (d) { d.style.display = 'none'; });
        }
    });

    /* ─── DROPDOWN TOGGLE ─── */
    window.adsToggleDropdown = function (id) {
        var menu = document.getElementById(id);
        if (!menu) return;
        var isOpen = menu.style.display !== 'none';
        // Close all dropdowns
        document.querySelectorAll('.toolbar-dropdown').forEach(function (d) { d.style.display = 'none'; });
        if (!isOpen) menu.style.display = 'block';
    };

    /* ─── TOAST ─── */
    window.adsShowToast = function (msg, type) {
        var toast = document.getElementById('ads-toast');
        if (!toast) return;
        toast.textContent = msg;
        toast.className   = 'ads-toast ads-toast-' + (type || 'info');
        toast.style.display = 'block';
        setTimeout(function () { toast.style.display = 'none'; }, 3200);
    };

    /* ─── CAMPAIGN DETAIL EXPAND ─── */
    document.querySelectorAll('.campaign-toggle').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            var cid = this.getAttribute('data-campaign-id');
            var detailRow = document.getElementById('detail-row-' + cid);
            if (!detailRow) return;

            // toggle visibility
            if (detailRow.style.display !== 'none') {
                detailRow.style.display = 'none';
                return;
            }
            detailRow.style.display = '';

            // if already loaded, skip fetch
            if (detailCache[cid]) return;

            // fetch
            fetch(KW_URL.replace(/\/$/, '') + '?campaign_id=' + cid, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var container = document.getElementById('detail-content-' + cid);
                    if (!data.success) {
                        container.innerHTML = '<div class="detail-empty">Error: ' + (data.error || 'Server error') + '</div>';
                        return;
                    }
                    detailCache[cid] = true; // only cache on success
                    if (!data.ads || data.ads.length === 0) {
                        container.innerHTML = '<div class="detail-empty">No ads found in this campaign.</div>';
                        return;
                    }
                    var html = '<table class="detail-table">';
                    html += '<thead><tr>';
                    html += '<th>Keyword</th><th>Match Type</th><th>Product</th>';
                    html += '<th>Bid (₹)</th><th>Spent (₹)</th>';
                    html += '<th>Impressions</th><th>Clicks</th><th>Status</th>';
                    html += '</tr></thead><tbody>';
                    data.ads.forEach(function (ad) {
                        var kw = ad.keyword || (ad.targeting_type === 'auto' ? '<em>Auto Targeting</em>' : '—');
                        var mt = ad.match_type || 'phrase';
                        var mtClass = 'mt-' + mt;
                        var mtLabel = mt.charAt(0).toUpperCase() + mt.slice(1);
                        var statusCls = parseInt(ad.is_active) ? 'st-active' : 'st-paused';
                        var statusLabel = parseInt(ad.is_active) ? 'Active' : 'Paused';
                        html += '<tr>';
                        html += '<td class="dt-kw">' + kw + '</td>';
                        html += '<td><span class="mt-badge ' + mtClass + '">' + mtLabel + '</span></td>';
                        html += '<td class="dt-prod">' + (ad.product_name || 'Product #' + ad.product_id) + '</td>';
                        html += '<td class="dt-num">₹' + parseFloat(ad.bid_amount).toFixed(2) + '</td>';
                        html += '<td class="dt-num">₹' + parseFloat(ad.spent_amount).toFixed(2) + '</td>';
                        html += '<td class="dt-num">' + (parseInt(ad.impressions) || 0) + '</td>';
                        html += '<td class="dt-num">' + (parseInt(ad.clicks) || 0) + '</td>';
                        html += '<td><span class="dt-status ' + statusCls + '">' + statusLabel + '</span></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    container.innerHTML = html;
                })
                .catch(function () {
                    document.getElementById('detail-content-' + cid).innerHTML = '<div class="detail-empty">Failed to load details.</div>';
                });
        });
    });

})();
</script>

<style>
