<!-- ── CHART.JS: stash RequireJS define to prevent anonymous define() conflict ── -->
<script>window.__requireDefine = window.define; window.define = undefined;</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@2.0.1/dist/chartjs-plugin-annotation.min.js"></script>
<script>window.define = window.__requireDefine; window.__requireDefine = undefined;</script>
<script>
(function () {
    'use strict';
    var Chart = window.Chart;
    var chartjsPluginAnnotation = window.chartjsPluginAnnotation;

    if (!Chart) { return; }
    if (chartjsPluginAnnotation) { Chart.register(chartjsPluginAnnotation); }

    const chartData     = <?= /* @noEscape */ $chartJson ?>;
    const changeMarkers = chartData.changeMarkers || [];

    // ── Quick Range Buttons ──
    document.querySelectorAll('.btn-range').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const days = parseInt(this.getAttribute('data-days'), 10);
            const to   = new Date();
            const from = new Date();
            from.setDate(from.getDate() - days);

            const fmt = d => d.toISOString().split('T')[0];
            document.getElementById('filterDateFrom').value = fmt(from);
            document.getElementById('filterDateTo').value   = fmt(to);
            document.getElementById('analyticsFilterForm').submit();
        });
    });

    if (!chartData.labels || chartData.labels.length === 0) return;

    // Build annotation objects for ⚡ change marker vertical lines
    const annotations = {};
    changeMarkers.forEach(function (label, i) {
        const idx = chartData.labels.indexOf(label);
        if (idx === -1) return;
        annotations['change_' + i] = {
            type: 'line',
            xMin: idx,
            xMax: idx,
            borderColor: 'rgba(255, 153, 0, 0.85)',
            borderWidth: 2,
            borderDash: [6, 3],
            label: {
                content: '⚡ Updated',
                display: true,
                position: 'start',
                backgroundColor: 'rgba(255,153,0,0.15)',
                color: '#c07000',
                font: { size: 11, weight: 'bold' },
                padding: 4,
                yAdjust: -10
            }
        };
    });

    // ── Line Chart: Impressions vs Clicks (continuous timeline) ──
    const lineCtx = document.getElementById('lineChart');
    if (lineCtx) {
        new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: chartData.labels,
                datasets: [
                    {
                        label: 'Impressions',
                        data: chartData.impressions,
                        borderColor: '#007185',
                        backgroundColor: 'rgba(0,113,133,0.08)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Clicks',
                        data: chartData.clicks,
                        borderColor: '#ff9900',
                        backgroundColor: 'rgba(255,153,0,0.08)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top' },
                    annotation: { annotations: annotations }
                },
                scales: {
                    y:  { title: { display: true, text: 'Impressions' }, beginAtZero: true },
                    y1: { position: 'right', title: { display: true, text: 'Clicks' }, beginAtZero: true, grid: { drawOnChartArea: false } }
                }
            }
        });
    }

    // ── Bar Chart: Spend per day ──
    const barCtx = document.getElementById('barChart');
    if (barCtx) {
        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: chartData.labels,
                datasets: [{
                    label: 'Spend (₹)',
                    data: chartData.spend,
                    backgroundColor: 'rgba(0,113,133,0.75)',
                    borderColor: '#007185',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, title: { display: true, text: '₹ Spend' } }
                }
            }
        });
    }
}());
</script>

