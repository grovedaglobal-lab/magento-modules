<script>
require(['jquery'], function ($) {
    var formKey = <?= json_encode($block->getFormKeyValue()) ?>;
    var createOrderUrl = <?= json_encode($block->getCreateOrderUrl()) ?>;
    var verifyUrl = <?= json_encode($block->getVerifyUrl()) ?>;
    var cancelPaymentUrl = <?= json_encode($block->getCancelPaymentUrl()) ?>;
    var taxMode = <?= json_encode($estimate['tax_mode']) ?>;

    function toFixed2(value) {
        return (Math.round(value * 100) / 100).toFixed(2);
    }

    function setMessage(message, isError) {
        var color = isError ? '#c62828' : '#2e7d32';
        $('#wallet_recharge_message').html('<span style="color:' + color + ';">' + message + '</span>');
    }

    function extractAjaxErrorMessage(xhr, fallbackMessage) {
        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }

        if (xhr && xhr.responseText) {
            try {
                var parsed = JSON.parse(xhr.responseText);
                if (parsed && parsed.message) {
                    return parsed.message;
                }
            } catch (e) {
                if (xhr.status) {
                    return fallbackMessage + ' (HTTP ' + xhr.status + ')';
                }
            }
        }

        return fallbackMessage;
    }

    function parseResponsePayload(payload) {
        if (payload && typeof payload === 'object') {
            return payload;
        }

        if (typeof payload !== 'string') {
            return null;
        }

        try {
            return JSON.parse(payload);
        } catch (e) {
            var start = payload.indexOf('{');
            var end = payload.lastIndexOf('}');
            if (start !== -1 && end !== -1 && end > start) {
                var maybeJson = payload.substring(start, end + 1);
                try {
                    return JSON.parse(maybeJson);
                } catch (ignore) {
                }
            }
        }

        return null;
    }

    function updatePreview() {
        var amount = parseFloat($('#wallet_recharge_amount').val() || '0');
        if (isNaN(amount) || amount < 0) {
            amount = 0;
        }

        var base;
        var gst;
        var total;

        if (taxMode === 'inclusive') {
            total = amount;
            base = total / 1.18;
            gst = total - base;
        } else {
            base = amount;
            gst = base * 0.18;
            total = base + gst;
        }

        $('#wallet_base_amount').text(toFixed2(base));
        $('#wallet_gst_amount').text(toFixed2(gst));
        $('#wallet_total_amount').text(toFixed2(total));
    }

    $('#wallet_recharge_amount').on('input', updatePreview);
    updatePreview();

    $('#wallet_recharge_pay').on('click', function () {
        var $btn = $(this);
        var originalBtnText = $btn.find('span').text();
        
        var amount = parseFloat($('#wallet_recharge_amount').val() || '0');
        if (isNaN(amount) || amount <= 0) {
            setMessage('<?= $block->escapeJs(__('Please enter a valid amount.')) ?>', true);
            return;
        }

        // Disable button and show processing
        $btn.prop('disabled', true).addClass('disabled').css('opacity', '0.6');
        $btn.find('span').text('<?= $block->escapeJs(__('Processing...')) ?>');
        setMessage('<?= $block->escapeJs(__('Creating payment order...')) ?>', false);

        function enableButton() {
            $btn.prop('disabled', false).removeClass('disabled').css('opacity', '1');
            $btn.find('span').text(originalBtnText);
        }

        function cancelPendingPayment(orderId) {
            if (!orderId) {
                return;
            }

            $.ajax({
                url: cancelPaymentUrl,
                type: 'POST',
                dataType: 'text',
                data: {
                    form_key: formKey,
                    razorpay_order_id: orderId
                }
            });
        }

        $.ajax({
            url: createOrderUrl,
            type: 'POST',
            dataType: 'text',
            data: {
                form_key: formKey,
                amount: amount
            }
        }).done(function (rawResponse) {
            var response = parseResponsePayload(rawResponse);
            if (!response || !response.success) {
                setMessage((response && response.message) ? response.message : '<?= $block->escapeJs(__('Unable to create order.')) ?>', true);
                enableButton();
                return;
            }

            var options = {
                key: response.key_id,
                amount: response.amount_paise,
                currency: response.currency || 'INR',
                name: response.merchant_name || '<?= $block->escapeJs(__('Vendor Ads Wallet Recharge')) ?>',
                description: '<?= $block->escapeJs(__('Wallet Recharge Payment')) ?>',
                order_id: response.razorpay_order_id,
                handler: function (rzpResponse) {
                    setMessage('<?= $block->escapeJs(__('Verifying payment...')) ?>', false);
                    $.ajax({
                        url: verifyUrl,
                        type: 'POST',
                        dataType: 'text',
                        data: {
                            form_key: formKey,
                            razorpay_order_id: rzpResponse.razorpay_order_id,
                            razorpay_payment_id: rzpResponse.razorpay_payment_id,
                            razorpay_signature: rzpResponse.razorpay_signature
                        }
                    }).done(function (verifyRawResponse) {
                        var verifyResponse = parseResponsePayload(verifyRawResponse);
                        if (verifyResponse && verifyResponse.success) {
                            setMessage('<?= $block->escapeJs(__('Payment successful. Wallet updated.')) ?>', false);
                            window.location.reload();
                        } else {
                            setMessage((verifyResponse && verifyResponse.message) ? verifyResponse.message : '<?= $block->escapeJs(__('Payment verification failed.')) ?>', true);
                            enableButton();
                        }
                    }).fail(function (xhr) {
                        setMessage(extractAjaxErrorMessage(xhr, '<?= $block->escapeJs(__('Payment verification request failed.')) ?>'), true);
                        enableButton();
                    });
                },
                "modal": {
                    "ondismiss": function() {
                        cancelPendingPayment(response.razorpay_order_id);
                        enableButton();
                        setMessage('<?= $block->escapeJs(__('Payment cancelled.')) ?>', true);
                    }
                },
                theme: {
                    color: '#2e7d32'
                }
            };

            var rzp = new Razorpay(options);
            rzp.open();
        }).fail(function (xhr) {
            setMessage(extractAjaxErrorMessage(xhr, '<?= $block->escapeJs(__('Could not create Razorpay order.')) ?>'), true);
            enableButton();
        });
    });
});
</script>
