<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="vendor_bulk_image_job" resource="default" engine="innodb" comment="Vendor Bulk Image Upload Job Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="job_id" nullable="false" length="255" comment="Unique Job ID"/>
        <column xsi:type="int" name="vendor_id" padding="10" unsigned="true" nullable="false" comment="Vendor ID"/>
        <column xsi:type="varchar" name="zip_filename" nullable="true" length="255" comment="Original ZIP Filename"/>
        <column xsi:type="varchar" name="status" nullable="false" length="50" default="pending" comment="Status (pending, processing, completed, failed)"/>
        <column xsi:type="int" name="total_skus" padding="10" unsigned="true" nullable="false" default="0" comment="Total SKUs Found"/>
        <column xsi:type="int" name="processed_skus" padding="10" unsigned="true" nullable="false" default="0" comment="Processed SKUs"/>
        <column xsi:type="int" name="success_count" padding="10" unsigned="true" nullable="false" default="0" comment="Successfully Processed Images"/>
        <column xsi:type="longtext" name="result_json" nullable="true" comment="JSON of success and errors"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="completed_at" on_update="false" nullable="true" comment="Completion Time"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="VENDOR_BULK_IMAGE_JOB_ID" indexType="btree">
            <column name="job_id"/>
        </index>
        <index referenceId="VENDOR_BULK_IMAGE_VENDOR_ID" indexType="btree">
            <column name="vendor_id"/>
        </index>
    </table>
</schema>
