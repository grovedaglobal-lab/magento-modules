<script type="text/javascript">
require(['jquery'], function ($) {
    'use strict';
    $(document).ready(function () {
        $('.view-job-errors-btn').on('click', function () {
            var $btn = $(this);
            var jobId = $btn.data('job-id');
            var $row = $('#job-details-' + jobId);
            if ($row.length) {
                $row.toggle();
                $btn.toggleClass('is-active', $row.is(':visible'));
            }
        });
    });
});
</script>
