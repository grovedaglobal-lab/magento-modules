<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="vendor_marketplace" xsi:type="array">
                    <item name="class" xsi:type="string">Vendor\Marketplace\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">50</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Plugins to redirect vendors away from customer dashboard -->
    <type name="Magento\Customer\Controller\Account\Index">
        <plugin name="vendor_marketplace_customer_account_index_redirect" type="Vendor\Marketplace\Plugin\Customer\AccountIndex" sortOrder="10"/>
    </type>
    <type name="Magento\Customer\Controller\Account\LoginPost">
        <plugin name="vendor_marketplace_customer_login_post_redirect" type="Vendor\Marketplace\Plugin\Customer\LoginPost" sortOrder="10"/>
    </type>
</config>
