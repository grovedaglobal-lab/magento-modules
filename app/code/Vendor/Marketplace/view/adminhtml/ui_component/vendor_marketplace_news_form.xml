<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">vendor_marketplace_news_form.vendor_marketplace_news_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">News Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Vendor\Marketplace\Block\Adminhtml\News\Edit\SaveButton"/>
            <button name="delete" class="Vendor\Marketplace\Block\Adminhtml\News\Edit\DeleteButton"/>
            <button name="back" class="Vendor\Marketplace\Block\Adminhtml\News\Edit\BackButton"/>
        </buttons>
        <namespace>vendor_marketplace_news_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>vendor_marketplace_news_form.vendor_marketplace_news_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="vendor_marketplace_news_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="vendor_marketplace/news/save"/>
        </settings>
        <dataProvider class="Vendor\Marketplace\Model\News\DataProvider" name="vendor_marketplace_news_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string"/>
            </item>
        </argument>
        <field name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataScope" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </field>
        <field name="status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="label" xsi:type="string" translate="true">Enable News</item>
                    <item name="dataScope" xsi:type="string">status</item>
                    <item name="default" xsi:type="number">1</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="false" xsi:type="number">0</item>
                        <item name="true" xsi:type="number">1</item>
                    </item>
                    <item name="prefer" xsi:type="string">toggle</item>
                </item>
            </argument>
        </field>
        <field name="title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="label" xsi:type="string" translate="true">Title</item>
                    <item name="dataScope" xsi:type="string">title</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="target_type">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Target Type</item>
                    <item name="dataScope" xsi:type="string">target_type</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="switcherConfig" xsi:type="array">
                        <item name="rules" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="value" xsi:type="string">all</item>
                                <item name="actions" xsi:type="array">
                                    <item name="0" xsi:type="array">
                                        <item name="target" xsi:type="string">vendor_marketplace_news_form.vendor_marketplace_news_form.general.seller_ids</item>
                                        <item name="callback" xsi:type="string">hide</item>
                                    </item>
                                </item>
                            </item>
                            <item name="1" xsi:type="array">
                                <item name="value" xsi:type="string">specific</item>
                                <item name="actions" xsi:type="array">
                                    <item name="0" xsi:type="array">
                                        <item name="target" xsi:type="string">vendor_marketplace_news_form.vendor_marketplace_news_form.general.seller_ids</item>
                                        <item name="callback" xsi:type="string">show</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                        <item name="enabled" xsi:type="boolean">true</item>
                    </item>
                </item>
                <item name="options" xsi:type="object">Vendor\Marketplace\Model\Source\News\TargetType</item>
            </argument>
        </field>
        <field name="seller_ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="label" xsi:type="string" translate="true">Selected Vendors</item>
                    <item name="dataScope" xsi:type="string">seller_ids</item>
                </item>
                <item name="options" xsi:type="object">Vendor\Marketplace\Model\Source\News\Sellers</item>
            </argument>
        </field>
        <field name="content">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Content</item>
                    <item name="formElement" xsi:type="string">wysiwyg</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="dataScope" xsi:type="string">content</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
