    <fieldset name="vendor_documents">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Upload Documents</item>
                <item name="sortOrder" xsi:type="number">50</item>
            </item>
        </argument>
        <dynamicRows name="documents">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="componentType" xsi:type="string">dynamicRows</item>
                    <item name="addButtonLabel" xsi:type="string" translate="true">Add Document</item>
                    <item name="deleteProperty" xsi:type="string">delete</item>
                    <item name="deleteValue" xsi:type="number">1</item>
                    <item name="columnsHeader" xsi:type="boolean">true</item>
                    <item name="dataScope" xsi:type="string">documents</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                </item>
            </argument>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                 <argument name="data" xsi:type="array">
                     <item name="config" xsi:type="array">
                         <item name="isTemplate" xsi:type="boolean">true</item>
                         <item name="is_collection" xsi:type="boolean">true</item>
                         <item name="componentType" xsi:type="string">container</item>
                         <item name="positionProvider" xsi:type="string">position</item>
                     </item>
                 </argument>
                <field name="entity_id" formElement="hidden">
                    <settings>
                        <dataType>text</dataType>
                        <dataScope>entity_id</dataScope>
                    </settings>
                </field>
                 <field name="position" formElement="hidden">
                     <settings>
                         <dataType>text</dataType>
                         <visible>false</visible>
                         <dataScope>position</dataScope>
                     </settings>
                 </field>
                 <field name="document_type" formElement="select">
                     <argument name="data" xsi:type="array">
                         <item name="config" xsi:type="array">
                             <item name="dataType" xsi:type="string">text</item>
                             <item name="label" xsi:type="string" translate="true">Document Type</item>
                             <item name="formElement" xsi:type="string">select</item>
                             <item name="dataScope" xsi:type="string">document_type</item>
                             <item name="sortOrder" xsi:type="number">10</item>
                             <item name="validation" xsi:type="array">
                                 <item name="required-entry" xsi:type="boolean">true</item>
                             </item>
                         </item>
                         <item name="options" xsi:type="array">
                             <item name="0" xsi:type="array">
                                 <item name="label" xsi:type="string" translate="true">-- Select --</item>
                                 <item name="value" xsi:type="string"></item>
                             </item>
                             <item name="1" xsi:type="array">
                                 <item name="label" xsi:type="string" translate="true">Business License</item>
                                 <item name="value" xsi:type="string">business_license</item>
                             </item>
                             <item name="2" xsi:type="array">
                                 <item name="label" xsi:type="string" translate="true">Tax Certificate</item>
