<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Vendor\Marketplace\Block\Product\SoldBy" name="vendor.product.soldby" template="Vendor_Marketplace::product/soldby.phtml" after="product.info.price"/>
            <block class="Magento\Catalog\Block\Product\View" name="product.info.weight" template="Vendor_Marketplace::product/view/weight.phtml" after="vendor.product.soldby"/>
            <block class="Vendor\Marketplace\Block\Product\ShippingLabel" name="vendor.product.shipping.label" template="Vendor_Marketplace::product/shipping_label.phtml" after="product.info.weight"/>
        </referenceContainer>
    </body>
</page>
