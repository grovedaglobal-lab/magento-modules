                    <div class="field email required">
                        <label class="label" for="email"><span>
                                <?= $block->escapeHtml(__('Email')) ?>
                            </span></label>
                        <div class="control">
                            <input name="login[username]" value="<?= $block->escapeHtmlAttr($block->getUsername()) ?>"
                                autocomplete="username" id="email" type="email" class="input-text"
                                title="<?= $block->escapeHtmlAttr(__('Email')) ?>"
