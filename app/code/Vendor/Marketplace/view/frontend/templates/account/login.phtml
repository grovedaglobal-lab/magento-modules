<style>
/* default: mask the visible input using CSS text-security */
#pass-visible {
    -webkit-text-security: disc;
    text-security: disc;
    font-family: 'Courier New', monospace;
}
#pass-visible.show-password {
    -webkit-text-security: none;
    text-security: none;
    font-family: inherit;
}
</style>

<script>
(function() {
    var visibleInput = document.getElementById('pass-visible');
    var hiddenInput = document.getElementById('pass');
    var toggleBtn = document.getElementById('pass-toggle');
    var icon = toggleBtn ? toggleBtn.querySelector('.eye-icon') : null;

    // Keep hidden input in sync for form submission
    if (visibleInput && hiddenInput) {
        visibleInput.addEventListener('input', function() {
            hiddenInput.value = visibleInput.value;
        });
    }

    // Sync hidden input on form submit
    var form = document.getElementById('login-form');
    if (form) {
        form.addEventListener('submit', function() {
            if (hiddenInput && visibleInput) {
                hiddenInput.value = visibleInput.value;
            }
        });
    }

    // Toggle show/hide
    if (toggleBtn) {
        toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (visibleInput) {
                visibleInput.classList.toggle('show-password');
                if (icon) {
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                }
            }
        });
    }

    // Fix Magento validation - point it to the visible input
    // Override data-validate to work on visible input
    if (visibleInput) {
        visibleInput.name = 'login[password_display]';
    }
})();
</script>
