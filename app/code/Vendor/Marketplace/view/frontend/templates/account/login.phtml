                            <!-- Hidden actual password input for form submission -->
                            <input name="login[password]" type="password" id="pass"
                                style="display:none;" tabindex="-1" aria-hidden="true"
                                autocomplete="current-password">
                            <!-- Visible text input that user types into -->
                            <input type="text" id="pass-visible"
                                class="input-text" style="padding-right: 40px;"
                                title="<?= $block->escapeHtmlAttr(__('Password')) ?>"
                                autocomplete="off" spellcheck="false"
                                data-validate="{required:true}"
