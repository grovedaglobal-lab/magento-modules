<style>
/* Mask visible password inputs via CSS text-security */
.reg-pass-visible {
    -webkit-text-security: disc;
    text-security: disc;
}
.reg-pass-visible.show-password {
    -webkit-text-security: none;
    text-security: none;
}
</style>

<script>
function initPasswordToggle() {
    var toggleBtns = document.querySelectorAll('.btn-toggle-password');
    toggleBtns.forEach(function (btn) {
        if (btn.dataset.initialized) return;
        btn.dataset.initialized = 'true';

        var visibleId = btn.getAttribute('data-target');
        var hiddenId  = btn.getAttribute('data-hidden');
        var visibleInput = document.getElementById(visibleId);
        var hiddenInput  = hiddenId ? document.getElementById(hiddenId) : null;

        // Sync visible -> hidden on every keystroke
        if (visibleInput && hiddenInput) {
            visibleInput.addEventListener('input', function () {
                hiddenInput.value = visibleInput.value;
            });
        }

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var icon = btn.querySelector('.eye-icon');
            if (visibleInput) {
                visibleInput.classList.toggle('show-password');
                if (icon) {
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                }
            }
        });
    });
}

function initShopUrlAuto() {
    var shopNameInput = document.getElementById('shop_name');
    var shopUrlInput = document.getElementById('shop_url');

    if (shopNameInput && shopUrlInput) {
        function generateShopUrl() {
            var val = shopNameInput.value || '';
            var urlKey = val
                .trim()
                .toLowerCase()
                .replace(/[\s-]+/g, '_')
                .replace(/[^a-z0-9_]/g, '');
            shopUrlInput.value = urlKey;
        }

        shopNameInput.addEventListener('input', generateShopUrl);
        shopNameInput.addEventListener('keyup', generateShopUrl);
        shopNameInput.addEventListener('change', generateShopUrl);
    }
}

// Sync all visible inputs to hidden on form submit
document.addEventListener('DOMContentLoaded', function() {
    initPasswordToggle();
    initShopUrlAuto();

    var form = document.getElementById('form-validate');
    if (form) {
        form.addEventListener('submit', function () {
            var pairs = [
                ['password-visible', 'password'],
                ['password-confirmation-visible', 'password-confirmation']
            ];
            pairs.forEach(function(pair) {
                var vis = document.getElementById(pair[0]);
                var hid = document.getElementById(pair[1]);
                if (vis && hid) hid.value = vis.value;
            });
        });
    }
});

if (document.readyState !== 'loading') {
    initPasswordToggle();
    initShopUrlAuto();
}
</script>