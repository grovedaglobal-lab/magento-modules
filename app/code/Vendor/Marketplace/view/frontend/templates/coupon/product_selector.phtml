<script type="text/javascript">
require(['jquery'], function ($) {
    'use strict';
    
    function updateSelectedCount() {
        var count = $('input[name="product_skus[]"]:checked').length;
        $('#selected_count_text').text(count);
        
        var total = $('input[name="product_skus[]"]').length;
        $('#select_all_header').prop('checked', total > 0 && count === total);
    }

    $(document).ready(function () {
        updateSelectedCount();

        // Checkbox change listener
        $(document).on('change', 'input[name="product_skus[]"]', function () {
            var $this = $(this);
            var parentId = $this.data('parent-id');
            
            // If parent toggled, toggle all its children
            if ($this.hasClass('parent-checkbox')) {
                $('.child-checkbox-' + parentId).prop('checked', $this.is(':checked'));
            } else if ($this.hasClass('child-checkbox')) {
                // If all children checked, check parent
                var allChildren = $('.child-checkbox-' + parentId);
                var checkedChildren = $('.child-checkbox-' + parentId + ':checked');
                if (checkedChildren.length > 0) {
                    $('#product_' + parentId).prop('checked', true);
                }
            }
            updateSelectedCount();
        });

        // Header checkbox toggle
        $('#select_all_header').on('change', function () {
            var isChecked = $(this).is(':checked');
            $('input[name="product_skus[]"]:visible').prop('checked', isChecked);
            updateSelectedCount();
        });

        // Quick action buttons
        $('#btn-select-all').on('click', function () {
            $('input[name="product_skus[]"]').prop('checked', true);
            updateSelectedCount();
        });

        $('#btn-deselect-all').on('click', function () {
            $('input[name="product_skus[]"]').prop('checked', false);
            updateSelectedCount();
        });

        // Live Product Search
        $('#coupon_product_search').on('input', function () {
            var query = $(this).val().toLowerCase().trim();
            if (!query) {
                $('.product-row').show();
                return;
            }

            $('.parent-row').each(function () {
                var $parent = $(this);
                var parentId = $parent.data('product-id');
                var $children = $('.child-of-' + parentId);
                
                var parentText = $parent.text().toLowerCase();
                var parentMatches = parentText.indexOf(query) !== -1;
                
                var childMatches = false;
                $children.each(function () {
                    var childText = $(this).text().toLowerCase();
                    if (childText.indexOf(query) !== -1) {
                        childMatches = true;
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });

                if (parentMatches) {
                    $parent.show();
                    $children.show();
                } else if (childMatches) {
                    $parent.show();
                } else {
                    $parent.hide();
                    $children.hide();
                }
            });
        });
    });
});
</script>
