<?php
/** @var \Vendor\Marketplace\Block\Notification\NotificationList $block */
$notifications = $block->getNotifications();
?>
<div class="vendor-notification-history-container">
    <div class="dashboard-controls">
        <div class="tabs">
            <h2 class="dashboard-page-title">
                <?= __('My Notifications') ?>
            </h2>
        </div>
        <div class="controls-right">
            <button type="button" class="action-btn" id="mark-all-read-page">
                <?= __('Mark All as Read') ?>
            </button>
        </div>
    </div>

    <div class="card stat-card full-height">
        <?php if ($notifications && $notifications->getSize() > 0): ?>
            <div class="notification-full-list">
                <?php foreach ($notifications as $notification): ?>
                    <div class="notification-row <?= $notification->getIsRead() ? 'is-read' : 'is-unread' ?>">
                        <div class="notif-content">
                            <div class="notif-header-row">
                                <span class="notif-type-tag type-<?= $notification->getType() ?>">
                                    <?= ucfirst(str_replace('_', ' ', $notification->getType())) ?>
                                </span>
                                <span class="notif-date">
                                    <?= $notification->getCreatedAt() ?>
                                </span>
                            </div>
                            <h3 class="notif-title-text">
                                <?= $block->escapeHtml($notification->getTitle()) ?>
                            </h3>
                            <p class="notif-msg-text">
                                <?= $block->escapeHtml($notification->getMessage()) ?>
                            </p>
                            <?php if ($notification->getLink()): ?>
                                <a href="<?= $block->getUrl($notification->getLink()) ?>" class="notif-link-btn">
                                    <?= __('View Details') ?>
                                </a>
                            <?php endif; ?>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
            <?php if ($block->getPagerHtml()): ?>
                <div class="order-history-toolbar bottom">
                    <div class="toolbar-right">
                        <?= $block->getPagerHtml() ?>
                    </div>
                </div>
            <?php endif; ?>
        <?php else: ?>
            <div class="empty-state">
                <p>
                    <?= __('You have no notifications yet.') ?>
                </p>
            </div>
        <?php endif; ?>
    </div>
</div>

