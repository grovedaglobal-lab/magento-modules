<script>
    require(['jquery'], function ($) {
        $('#mark-all-read-page').on('click', function () {
            const markReadUrl = '<?= $block->getUrl('vendor_marketplace/notification/markRead') ?>';
            $.ajax({
                url: markReadUrl,
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    if (data.success) {
                        location.reload();
                    }
                }
            });
        });
    });
</script>