<script>
    /* â”€â”€â”€ Mass Action â”€â”€â”€ */
    function submitMassAction(url) {
        var form = document.getElementById('mass-action-form');
        if (!form) { console.error('Mass action form not found'); return; }
        var checkboxes = form.querySelectorAll('input[name="order_ids[]"]:checked');
        if (checkboxes.length === 0) {
            alert('<?= __('Please select at least one order.') ?>');
            return;
        }
        form.action = url;
        form.submit();
    }

    /* â”€â”€â”€ Panel Toggle Logic â”€â”€â”€ */
    var openPanel = null;
    var openBtn   = null;

    function togglePanel(panelId, btnId) {
        var panel = document.getElementById(panelId);
        var btn   = document.getElementById(btnId);

        // Close currently open panel if different
        if (openPanel && openPanel !== panel) {
            openPanel.classList.remove('panel-visible');
            if (openBtn) openBtn.classList.remove('panel-open');
        }

        if (panel.classList.contains('panel-visible')) {
            panel.classList.remove('panel-visible');
            btn.classList.remove('panel-open');
            openPanel = null;
            openBtn   = null;
        } else {
            panel.classList.add('panel-visible');
            btn.classList.add('panel-open');
            openPanel = panel;
            openBtn   = btn;
        }
    }

    function closePanel(panelId, btnId) {
        var panel = document.getElementById(panelId);
        var btn   = document.getElementById(btnId);
        if (panel) panel.classList.remove('panel-visible');
        if (btn)   btn.classList.remove('panel-open');
        openPanel = null;
        openBtn   = null;
    }

    /* â”€â”€â”€ Filters â”€â”€â”€ */
    function applyFiltersPanel() {
        var url    = '<?= $block->getUrl('marketplace/order/history') ?>';
        var params = [];
        var fields = ['fp-increment-id', 'fp-date-from', 'fp-date-to', 'fp-customer', 'fp-status'];
        var names  = ['increment_id', 'date_from', 'date_to', 'customer', 'status'];

        fields.forEach(function(id, i) {
            var el = document.getElementById(id);
            if (el && el.value) {
                params.push(names[i] + '=' + encodeURIComponent(el.value));
            }
        });

        window.location.href = params.length ? url + '?' + params.join('&') : url;
    }

    function clearFilters() {
        window.location.href = '<?= $block->getUrl('marketplace/order/history') ?>';
    }

    /* â”€â”€â”€ Columns Toggle â”€â”€â”€ */
    function applyColumns() {
        var checkboxes = document.querySelectorAll('.col-toggle input[data-col]');
        checkboxes.forEach(function(cb) {
            var colClass = cb.getAttribute('data-col');
            var cells = document.querySelectorAll('.' + colClass);
            cells.forEach(function(cell) {
                cell.style.display = cb.checked ? '' : 'none';
            });
        });
        closePanel('columns-panel', 'btn-columns');
    }

    function resetColumns() {
        var checkboxes = document.querySelectorAll('.col-toggle input[data-col]');
        checkboxes.forEach(function(cb) {
            cb.checked = true;
        });
        applyColumns();
    }

    /* â”€â”€â”€ Default View â”€â”€â”€ */
    function applyView() {
        var selected = document.querySelector('input[name="grid-view"]:checked');
        if (selected) {
            document.querySelectorAll('.view-option').forEach(function(el) {
                el.classList.remove('active-view');
            });
            selected.closest('.view-option').classList.add('active-view');
            localStorage.setItem('order-grid-view', selected.value);
        }
        closePanel('default-view-panel', 'btn-default-view');
    }

    /* â”€â”€â”€ jQuery extras â”€â”€â”€ */
    require(['jquery'], function ($) {
        $('#select-all-orders').change(function () {
            $('.order-checkbox').prop('checked', $(this).prop('checked'));
        });

        // Enter key on filter inputs
        $('#filters-panel input').keypress(function (e) {
            if (e.which == 13) { applyFiltersPanel(); }
        });

        // Close panels when clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('.slide-panel, .tool-btn').length && openPanel) {
                openPanel.classList.remove('panel-visible');
                if (openBtn) openBtn.classList.remove('panel-open');
                openPanel = null;
                openBtn   = null;
            }
        });

        // Click on view card instantly selects it
        $(document).on('click', '.view-option', function () {
            $('.view-option').removeClass('active-view');
            $(this).addClass('active-view');
            $(this).find('input[type="radio"]').prop('checked', true);
        });

        // Restore saved view
        var savedView = localStorage.getItem('order-grid-view');
        if (savedView) {
            var radio = document.querySelector('input[name="grid-view"][value="' + savedView + '"]');
            if (radio) {
                radio.checked = true;
                document.querySelectorAll('.view-option').forEach(function(el) { el.classList.remove('active-view'); });
                radio.closest('.view-option').classList.add('active-view');
            }
        }
    });
</script>







