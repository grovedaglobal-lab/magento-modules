<script>
    function submitMassAction(url) {
        var form = document.getElementById('mass-action-form');
        if (!form) {
            console.error('Mass action form not found');
            return;
        }
        var checkboxes = form.querySelectorAll('input[name="order_ids[]"]:checked');
        if (checkboxes.length === 0) {
            alert('<?= __('Please select at least one order.') ?>');
            return;
        }
        form.action = url;
        form.submit();
    }

    function toggleFilters() {
        var row = document.getElementById('order-filter-row');
        if (row.style.display === 'none') {
            row.style.display = 'table-row';
        } else {
            row.style.display = 'none';
        }
    }

    function applyFilters() {
        var url = '<?= $block->getUrl('marketplace/order/history') ?>';
        var params = [];
        var inputs = document.querySelectorAll('#order-filter-row input, #order-filter-row select');

        inputs.forEach(function (input) {
            if (input.value) {
                params.push(input.name + '=' + encodeURIComponent(input.value));
            }
        });

        if (params.length > 0) {
            url += '?' + params.join('&');
        } else {
            url = '<?= $block->getUrl('marketplace/order/history') ?>';
        }
        window.location.href = url;
    }

    function clearFilters() {
        window.location.href = '<?= $block->getUrl('marketplace/order/history') ?>';
    }

    require(['jquery'], function ($) {
        $('#select-all-orders').change(function () {
            $('.order-checkbox').prop('checked', $(this).prop('checked'));
        });

        // Handle Enter key in filter fields
        $('#order-filter-row input').keypress(function (e) {
            if (e.which == 13) {
                applyFilters();
            }
        });
    });
</script>

