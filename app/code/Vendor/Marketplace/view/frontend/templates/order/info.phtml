<?php
/** @var $block \Vendor\Marketplace\Block\Order\Info */
$_order = $block->getOrder();
$paymentCode = $_order && $_order->getPayment() ? (string) $_order->getPayment()->getMethod() : '';
$paymentInfoHtml = $_order && $_order->getPayment() ? (string) $block->getPaymentInfoHtml() : '';
$hasVisiblePaymentInfo = trim(strip_tags($paymentInfoHtml)) !== '';
?>
<div class="order-details-wrapper">
    <!-- Payment & Shipping Method Section -->
    <div class="payment-shipping-section">
        <h3 class="section-title"><?= $block->escapeHtml(__('Payment & Shipping Method')) ?></h3>

        <div class="payment-shipping-grid">
            <!-- Payment Information -->
            <div class="payment-info-box">
                <h4 class="box-title"><?= $block->escapeHtml(__('Payment Information')) ?></h4>
                <div class="box-content">
                    <?php if ($_order->getPayment()): ?>
                        <div class="payment-method">
                            <strong><?= $block->escapeHtml($block->getResolvedPaymentMethodTitle()) ?></strong>
                        </div>
                        <?php if ($_order->getOrderCurrencyCode()): ?>
                            <div class="payment-currency">
                                <?= $block->escapeHtml(__('The order was placed using %1.', $_order->getOrderCurrencyCode())) ?>
                            </div>
                        <?php endif; ?>

                        <!-- Additional Payment Info Block -->
                        <div class="payment-info-details">
                            <?php if ($hasVisiblePaymentInfo): ?>
                                <?= /* @noEscape */ $paymentInfoHtml ?>
                            <?php elseif ($paymentCode === 'cashondelivery' || $paymentCode === 'checkmo'): ?>
                                <div class="payment-currency">
                                    <?= $block->escapeHtml(__('Payment will be collected at the time of delivery.')) ?>
                                </div>
                            <?php else: ?>
                                <div class="payment-currency">
                                    <?= $block->escapeHtml(__('No additional payment details were provided by the gateway.')) ?>
                                </div>
                            <?php endif; ?>
                        </div>
                    <?php else: ?>
                        <div class="payment-method">
                            <strong><?= $block->escapeHtml(__('Payment method unavailable')) ?></strong>
                        </div>
                    <?php endif; ?>
                </div>
            </div>

            <!-- Shipping & Handling Information -->
            <div class="shipping-info-box">
                <h4 class="box-title"><?= $block->escapeHtml(__('Shipping & Handling Information')) ?></h4>
                <div class="box-content">
                    <?php if (!$_order->getIsVirtual()): ?>
                        <?php if ($_order->getShippingDescription()): ?>
                            <div class="shipping-method">
                                <strong><?= $block->escapeHtml($_order->getShippingDescription()) ?></strong>
                            </div>
                        <?php endif; ?>
                        <?php if ($_order->getShippingAmount()): ?>
                            <div class="shipping-amount">
                                <?= /* @noEscape */ $_order->formatPrice($_order->getShippingAmount()) ?>
                            </div>
                        <?php endif; ?>
                    <?php else: ?>
                        <div class="virtual-order">
                            <?= $block->escapeHtml(__('No shipping required (Virtual Order)')) ?>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Information Section -->
    <div class="block block-order-details-view">
        <div class="block-title">
            <strong><?= $block->escapeHtml(__('Order Information')) ?></strong>
        </div>
        <div class="block-content">
            <!-- Customer Email Box (consistent theme) -->
            <div class="box box-customer-email">
                <strong class="box-title">
                    <span><?= $block->escapeHtml(__('Customer Information')) ?></span>
                </strong>
                <div class="box-content">
                    <div class="info-row">
                        <strong><?= $block->escapeHtml(__('Email:')) ?></strong>
                        <a href="mailto:<?= $block->escapeHtml($_order->getCustomerEmail()) ?>"
                            class="customer-email-link">
                            <?= $block->escapeHtml($_order->getCustomerEmail()) ?>
                        </a>
                    </div>
                </div>
            </div>

            <div class="order-info-grid">
                <?php if (!$_order->getIsVirtual()): ?>
