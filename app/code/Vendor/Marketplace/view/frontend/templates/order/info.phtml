                <div class="box box-order-billing-address">
                    <strong class="box-title">
                        <span><?= $block->escapeHtml(__('Billing Address')) ?></span>
                    </strong>
                    <div class="box-content">
                        <address><?= /* @noEscape */ $block->getFormattedAddress($_order->getBillingAddress()) ?>
                        </address>
                    </div>
                </div>
            </div>
        </div>
