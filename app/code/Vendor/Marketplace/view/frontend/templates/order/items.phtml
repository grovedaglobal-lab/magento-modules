        }

        .table-order-items .col.price,
        .table-order-items .col.subtotal,
        .table-order-items .col.tax,
        .table-order-items .col.discount,
        .table-order-items .col.rowtotal,
        .table-order-items .col.cgst,
        .table-order-items .col.sgst,
        .table-order-items .col.igst {
            text-align: right;
