<?php foreach ($_invoices as $_invoice): ?>
    <?php $_order = $_invoice->getOrder(); ?>
    <?php
    // In Option 2, we assume 1 Invoice ID = 1 Vendor.
    // We pick the vendor ID from the first item of this invoice.
    $vendorId = null;
    foreach ($_invoice->getAllItems() as $item) {
        if ($item->getOrderItem()->getParentItem()) {
            continue;
        }
        $p = $item->getOrderItem()->getProduct();
        $vendorId = $p ? $p->getData('vendor_id') : null;
        if ($vendorId)
            break;
    }
    $isWalletRecharge = (bool)$_order->getData('is_wallet_recharge');

    $vendorData = null;
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    
    if ($isWalletRecharge) {
        $scopeConfig = $objectManager->get(\Magento\Framework\App\Config\ScopeConfigInterface::class);
        $adminName = $scopeConfig->getValue('general/store_information/name', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        $adminStreet = $scopeConfig->getValue('general/store_information/street_line1', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        $adminCity = $scopeConfig->getValue('general/store_information/city', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        
        $regionId = $scopeConfig->getValue('general/store_information/region_id', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        $adminState = '';
        if ($regionId) {
            $regionModel = $objectManager->create(\Magento\Directory\Model\Region::class)->load($regionId);
            $adminState = $regionModel->getName();
        }
        
        $adminZip = $scopeConfig->getValue('general/store_information/postcode', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        $adminCountry = $scopeConfig->getValue('general/store_information/country_id', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        $adminGst = $scopeConfig->getValue('tax_indiangst/general/gstin', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        if (!$adminGst || strlen(trim($adminGst)) < 15) {
            $adminGst = $scopeConfig->getValue('general/store_information/merchant_vat_number', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
        }
        
        $adminPan = '';
        if ($adminGst && strlen(trim($adminGst)) >= 15) {
            $adminPan = substr(trim($adminGst), 2, 10);
        }
        
        $vendorData = [
            'business_name' => $adminName ?: __('Marketplace Admin'),
            'shop_name'     => $adminName ?: __('Marketplace Admin'),
            'address'       => $adminStreet,
            'city'          => $adminCity,
            'state'         => $adminState,
            'zip_code'      => $adminZip,
            'country'       => $adminCountry,
            'pan_number'    => $adminPan,
            'gstin'         => $adminGst,
            'signature'     => '',
            'authorized_name' => $adminName ?: __('Marketplace Admin')
        ];
    } elseif ($vendorId) {
        $resource = $objectManager->get(\Magento\Framework\App\ResourceConnection::class);
        $connection = $resource->getConnection();
        $tableName = $resource->getTableName('vendor_profile');
        $gstTableName = $resource->getTableName('tax_indiangst_vendor_profile');
        $profileColumns = $connection->describeTable($tableName);
        $gstColumns = $connection->describeTable($gstTableName);
        
        $gstJoinConditions = [];
        if (isset($gstColumns['vendor_code'])) {
            $gstJoinConditions[] = 'vp.vendor_id = gst.vendor_code';
        }
        if (isset($gstColumns['vendor_id'])) {
            $gstJoinConditions[] = 'vp.vendor_id = gst.vendor_id';
        }

        $gstSelectColumns = [];
        foreach (['gstin', 'pan_number', 'business_name'] as $gstColumn) {
            if (isset($gstColumns[$gstColumn])) {
                $gstSelectColumns[$gstColumn] = $gstColumn;
            }
        }

        // Build the GST join from the real table columns. Some installs only have gstin/pan fields here.
        $select = $connection->select()
            ->from(['vp' => $tableName]);

        if ($gstJoinConditions && $gstSelectColumns) {
            $select->joinLeft(
                ['gst' => $gstTableName],
                implode(' OR ', $gstJoinConditions),
                $gstSelectColumns
            );
        }

        $select->where('vp.vendor_id = ?', $vendorId);
            
        $vendorData = $connection->fetchRow($select);
        
        // Populate gstin from tax_id/vat_id if missing
        if ($vendorData && empty($vendorData['gstin'])) {
            $vendorData['gstin'] = ($vendorData['tax_id'] ?? null) ?: ($vendorData['vat_id'] ?? null);
        }
        
        // fallback if no GST record found with join, just get from profile
        if (!$vendorData) {
            $vendorData = $connection->fetchRow(
                $connection->select()->from($tableName)->where('vendor_id = ?', $vendorId)
            );
        }
        
        // Final fallback: check for some standard profile fields if gst join was empty
        if ($vendorData && empty($vendorData['gstin'])) {
            // Check if gstin exists in the main profile table directly (some versions)
            if (isset($profileColumns['gstin'])) {
                $select = $connection->select()->from($tableName, ['gstin'])->where('vendor_id = ?', $vendorId);
                $gstVal = $connection->fetchOne($select);
                $vendorData['gstin'] = $gstVal;
            }
        }
    }
