                <span class="section-header"><?= __('Sold By :') ?></span>
                <?php if ($vendorData): ?>
                    <div class="address-block">
                        <strong><?= $block->escapeHtml($vendorData['business_name'] ?: $vendorData['shop_name']) ?></strong><br>
                        <?= $block->escapeHtml($vendorData['address']) ?><br>
                        <?= $block->escapeHtml($vendorData['city']) ?>, <?= $block->escapeHtml($vendorData['state']) ?> -
                        <?= $block->escapeHtml($vendorData['zip_code']) ?><br>
                        <?= $block->escapeHtml($vendorData['country'] ?: __('India')) ?>
                    </div>
                    <div class="tax-info">
                        <?php if (!empty($vendorData['pan_number'])): ?>
                            <strong><?= __('PAN No:') ?></strong> <?= $block->escapeHtml($vendorData['pan_number']) ?><br>
                        <?php endif; ?>
                        <?php if (!empty($vendorData['gstin'])): ?>
                            <strong><?= __('GST Registration No:') ?></strong> <?= $block->escapeHtml($vendorData['gstin']) ?><br>
                        <?php endif; ?>
                    </div>
                <?php else: ?>
                    <strong><?= __('Default Seller / Admin') ?></strong>
                <?php endif; ?>
            </div>

            <div class="col-right">
                <div class="address-block">
                    <span class="section-header"><?= __('Billing Address :') ?></span>
                    <?php if ($isWalletRecharge): ?>
                        <?php
                        // For wallet recharges, the 'payer' is the vendor.
                        // Fetch the vendor profile for the customer who placed the order.
                        $payerCustomerId = $_order->getCustomerId();
                        $payerCustomerEmail = $_order->getCustomerEmail();
                        $payerVendorProfile = null;
                        
                        if ($payerCustomerId || $payerCustomerEmail) {
                            $resource = $objectManager->get(\Magento\Framework\App\ResourceConnection::class);
                            $connection = $resource->getConnection();
                            $profileTable = $resource->getTableName('vendor_profile');
                            $gstTable = $resource->getTableName('tax_indiangst_vendor_profile');
                            $vendorTable = $resource->getTableName('vendor_entity');
                            $profileColumns = $connection->describeTable($profileTable);
                            $gstColumns = $connection->describeTable($gstTable);
                            $vendorColumns = $connection->describeTable($vendorTable);
                            
                            // 1. Get vendor_id for this customer (by ID or Email)
                            $profileSelectColumns = [];
                            foreach (['vendor_id', 'business_name', 'shop_name', 'address', 'city', 'state', 'zip_code', 'country', 'vendor_name', 'gstin', 'tax_id', 'vat_id'] as $profileColumn) {
                                if (isset($profileColumns[$profileColumn])) {
                                    $profileSelectColumns[$profileColumn] = $profileColumn;
                                }
                            }

                            $selectId = $connection->select()
                                ->from(['vp' => $profileTable], $profileSelectColumns ?: ['vendor_id']);

                            if ($payerCustomerId && isset($profileColumns['user_id'])) {
                                $selectId->where('vp.user_id = ?', (int)$payerCustomerId);
                            } elseif ($payerCustomerId && isset($vendorColumns['customer_id'])) {
                                $selectId->joinLeft(
                                    ['ve' => $vendorTable],
                                    'vp.vendor_id = ve.entity_id',
                                    []
                                )->where('ve.customer_id = ?', (int)$payerCustomerId);
                            }

                            if ($payerCustomerEmail && isset($profileColumns['email'])) {
                                $selectId->orWhere('vp.email = ?', $payerCustomerEmail);
                            }
                            
                            $payerVendorProfile = $connection->fetchRow($selectId);
                            
                            if ($payerVendorProfile && !empty($payerVendorProfile['vendor_id'])) {
                                // 2. Get GST details using the vendor_id
                                $gstWhere = [];
                                if (isset($gstColumns['vendor_code'])) {
                                    $gstWhere[] = $connection->quoteInto('vendor_code = ?', $payerVendorProfile['vendor_id']);
                                }
                                if (isset($gstColumns['vendor_id'])) {
                                    $gstWhere[] = $connection->quoteInto('vendor_id = ?', $payerVendorProfile['vendor_id']);
                                }

                                $gstData = null;
                                if ($gstWhere) {
                                    $selectGst = $connection->select()
                                        ->from($gstTable)
                                        ->where(implode(' OR ', $gstWhere));
                                    $gstData = $connection->fetchRow($selectGst);
                                }
                                
                                if ($gstData) {
                                    $payerVendorProfile['gstin'] = ($gstData['gstin'] ?? null)
                                        ?: (($gstData['vat_id'] ?? null) ?: ($gstData['tax_id'] ?? null));
                                    $payerVendorProfile['pan_number'] = ($gstData['pan_number'] ?? null) ?: ($gstData['pan'] ?? null);
                                    if (empty($payerVendorProfile['business_name'])) {
                                        $payerVendorProfile['business_name'] = $gstData['business_name'] ?? null;
                                    }
                                }
                            }
                            
                            // 3. Fallback to customer account attributes if still missing gstin
                            if ($payerVendorProfile && empty($payerVendorProfile['gstin'])) {
                                try {
                                    $customerRepository = $objectManager->get(\Magento\Customer\Api\CustomerRepositoryInterface::class);
                                    $customer = null;
                                    if ($payerCustomerId) {
                                        $customer = $customerRepository->getById($payerCustomerId);
                                    } elseif ($payerCustomerEmail) {
                                        $customer = $customerRepository->getForCustomer($payerCustomerEmail);
                                    }
                                    
                                    if ($customer) {
                                        $custGst = $customer->getCustomAttribute('gstin') ?: ($customer->getCustomAttribute('tax_id') ?: $customer->getCustomAttribute('vat_id'));
                                        if ($custGst) {
                                            $payerVendorProfile['gstin'] = $custGst->getValue();
                                        }
                                    }
                                } catch (\Exception $e) {}
                            }
                            
                            // 4. Final fallback to order billing vat_id
                            if ($payerVendorProfile && empty($payerVendorProfile['gstin'])) {
                                $payerVendorProfile['gstin'] = $_order->getBillingAddress()->getVatId();
                            }
                        }
                        ?>
                        <?php if ($payerVendorProfile): ?>
                            <div class="address-block">
                                <strong><?= $block->escapeHtml($payerVendorProfile['business_name'] ?: ($payerVendorProfile['shop_name'] ?: $payerVendorProfile['vendor_name'])) ?></strong><br>
                                <?= $block->escapeHtml($payerVendorProfile['address']) ?><br>
                                <?= $block->escapeHtml($payerVendorProfile['city']) ?>, <?= $block->escapeHtml($payerVendorProfile['state']) ?> -
                                <?= $block->escapeHtml($payerVendorProfile['zip_code']) ?><br>
                                <?= $block->escapeHtml($payerVendorProfile['country'] ?: __('India')) ?><br>
                                <?php if (!empty($payerVendorProfile['gstin'])): ?>
                                    <strong><?= __('GSTIN:') ?></strong> <?= $block->escapeHtml($payerVendorProfile['gstin']) ?><br>
                                <?php endif; ?>
                                <?php if (!empty($payerVendorProfile['pan_number'])): ?>
                                    <strong><?= __('PAN:') ?></strong> <?= $block->escapeHtml($payerVendorProfile['pan_number']) ?>
                                <?php endif; ?>
                            </div>
                        <?php else: ?>
                            <address>
                                <?= /* @noEscape */ $block->formatAddress($_order->getBillingAddress(), 'html') ?>
                                <?php if ($_order->getBillingAddress()->getVatId()): ?>
                                    <br><strong><?= __('GSTIN:') ?></strong> <?= $block->escapeHtml($_order->getBillingAddress()->getVatId()) ?>
                                <?php endif; ?>
                            </address>
                        <?php endif; ?>
                    <?php else: ?>
                        <?php $_billing = $_order->getBillingAddress() ?>
                        <address><?= /* @noEscape */ $block->formatAddress($_billing, 'html') ?></address>
                        <strong><?= __('State/UT Code:') ?></strong> <?= $_billing->getRegionId() ?>
                        <?php if ($_billing->getVatId()): ?>
                            <br><strong><?= __('GSTIN:') ?></strong> <?= $block->escapeHtml($_billing->getVatId()) ?>
                        <?php endif; ?>
                    <?php endif; ?>
