                    $adminLogo = $scopeConfig->getValue('tax_indiangst/general/admin_logo', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);

                    if ($adminLogo) {
                        $storeManager = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class);
                        $mediaBaseUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
                        $logoPath = 'tax/indiangst/admin_logo/' . ltrim($adminLogo, '/');
                        $logoUrl = $mediaBaseUrl . $logoPath;
