                    <th width="7%">SGST</th>
                    <th width="7%">IGST</th>
                    <th width="10%">Total Amount</th>
                </tr>
            </thead>
            <?php
            $totalCGST = 0;
            $totalSGST = 0;
            $totalIGST = 0;
            foreach ($_invoice->getAllItems() as $_item) {
                if (!$_item->getOrderItem()->getParentItem()) {
                    $totalCGST += (float) $_item->getData('indiangst_cgst_amount');
                    $totalSGST += (float) $_item->getData('indiangst_sgst_amount');
                    $totalIGST += (float) $_item->getData('indiangst_igst_amount');
                }
            }
            ?>
            <?php foreach ($_invoice->getAllItems() as $_item): ?>
                <?php if (!$_item->getOrderItem()->getParentItem()): ?>
                    <tbody>
                        <?= $block->getItemHtml($_item) ?>
                    </tbody>
                <?php endif; ?>
            <?php endforeach; ?>
            <!-- TOTAL ROW -->
            <!-- TOTALS -->
            <tfoot>
                <!-- Subtotal -->
                <tr>
                    <td colspan="4" class="text-right"><strong><?= __('Subtotal') ?></strong></td>
                    <td class="text-right"><?= $_order->formatPrice($_invoice->getSubtotal()) ?></td>
                </tr>

                <!-- Taxes Breakdown -->
                <?php if ($totalCGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('CGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalCGST) ?></td>
                    </tr>
                <?php endif; ?>

                <?php if ($totalSGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('SGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalSGST) ?></td>
                    </tr>
                <?php endif; ?>

                <?php if ($totalIGST > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('IGST') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($totalIGST) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Fallback: If no specific GST data found but there is tax amount (e.g. legacy/other tax) -->
                <?php if ($totalCGST == 0 && $totalSGST == 0 && $totalIGST == 0 && $_invoice->getTaxAmount() > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Tax Amount') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getTaxAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Shipping -->
                <?php if ($_invoice->getShippingAmount() > 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Shipping Charge') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getShippingAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Discount -->
                <?php if ($_invoice->getDiscountAmount() < 0): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Discount') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($_invoice->getDiscountAmount()) ?></td>
                    </tr>
                <?php endif; ?>

                <?php
                // Recalculate Grand Total based on displayed components
                $calculatedGrandTotal = $_invoice->getSubtotal()
                    + $_invoice->getShippingAmount()
                    + $_invoice->getDiscountAmount();

                if ($totalCGST > 0 || $totalSGST > 0 || $totalIGST > 0) {
                    $calculatedGrandTotal += $totalCGST + $totalSGST + $totalIGST;
                } else if ($_invoice->getTaxAmount() > 0) {
                    $calculatedGrandTotal += $_invoice->getTaxAmount();
                }

                // stored grand total might be wrong (missing tax)
                // So we prefer the calculated total.
            
                // Logic: Round the calculated total to nearest integer to get "Target Total"
                // Then difference is Round Off.
                $targetGrandTotal = round($calculatedGrandTotal);

                // If the stored grand total is correct (matches calculated within small margin), use it.
                // But here we know stored is 666.67 and calculated is 700.01.
            
                // Use explicit rounding to 2 decimals to avoid floating point weirdness
                $roundOffArgs = round($targetGrandTotal - $calculatedGrandTotal, 2);

                // Final display should be the Target (Rounded) Total
                $finalGrandTotal = $targetGrandTotal;
                ?>

                <!-- Round Off Row -->
                <?php if (abs($roundOffArgs) >= 0.01): ?>
                    <tr>
                        <td colspan="8" class="text-right"><strong><?= __('Round Off') ?></strong></td>
                        <td class="text-right"><?= $_order->formatPrice($roundOffArgs) ?></td>
                    </tr>
                <?php endif; ?>

                <!-- Grand Total -->
                <tr class="grand-total">
                    <td colspan="8" class="text-right"><strong><?= __('Grand Total') ?></strong></td>
                    <td class="text-right" style="background: #ddd; font-weight: bold;">
                        <?= $_order->formatPrice($finalGrandTotal) ?>
                    </td>
                </tr>
            </tfoot>
        </table>

        <!-- FOOTER -->
        <div class="footer-section">
            <div class="amount-words-row">
                <?= __('Amount in Words:') ?><br>
                <?= $gstHelper->amountToWords($finalGrandTotal) ?>
            </div>

            <div style="font-size: 9px; margin-bottom: 5px; font-style: italic;">
                <?= __('* Rounding off is applicable as per Section 170 of CGST Act, 2017.') ?>
            </div>

            <div style="text-align: right;">
                <strong><?= __('For %1', $vendorData ? $vendorData['business_name'] : 'Confirmed Seller') ?>:</strong>
                <?php if ($vendorData && !empty($vendorData['gstin'])): ?>
                    <div style="font-size: 8px; color: #555;"><?= __('GSTIN: %1', $vendorData['gstin']) ?></div>
                <?php endif; ?>
                <div class="signatory-block">
                    <?php if ($vendorData && !empty($vendorData['signature'])): ?>
                        <?php
                        $mediaUrl = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class)
                            ->getStore()
                            ->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
                        $signatureUrl = $mediaUrl . 'vendor/signature/' . ltrim($vendorData['signature'], '/');
                        ?>
                        <img src="<?= $signatureUrl ?>" alt="Signature" style="max-height: 50px; margin-bottom: 5px;"><br>
                    <?php else: ?>
                        <br><br>
                    <?php endif; ?>
                    <strong style="text-decoration: underline;"><?= __('Authorized Signatory') ?></strong>
                    <?php if ($vendorData && !empty($vendorData['authorized_name'])): ?>
                        <br><strong><?= $block->escapeHtml($vendorData['authorized_name']) ?></strong>
                    <?php endif; ?>
                </div>
            </div>
        </div>
        <div class="reverse-charge">
            <?= __('Whether tax is payable under reverse charge - No') ?>
        </div>
    </div>
<?php endforeach; ?>
