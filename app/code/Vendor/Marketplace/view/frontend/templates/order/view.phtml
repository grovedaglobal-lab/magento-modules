<?php
/** @var \Vendor\Marketplace\Block\Order\View $block */
$writer = new \Zend_Log_Writer_Stream(BP . '/var/log/vendor_order_debug.log');
$logger = new \Zend_Log();
$logger->addWriter($writer);

$logger->info('TEMPLATE: Starting view.phtml rendering');

try {
    $vendorOrder = $block->getVendorOrder();
    $logger->info('TEMPLATE: getVendorOrder() returned: ' . ($vendorOrder ? 'VendorOrder ID ' . $vendorOrder->getId() : 'NULL'));
} catch (\Exception $e) {
    $logger->info('TEMPLATE ERROR in getVendorOrder(): ' . $e->getMessage());
    throw $e;
}

try {
    $order = $block->getOrder();
    $logger->info('TEMPLATE: getOrder() returned: ' . ($order ? 'Order ID ' . $order->getId() : 'NULL'));
} catch (\Exception $e) {
    $logger->info('TEMPLATE ERROR in getOrder(): ' . $e->getMessage());
    throw $e;
}

if (!$vendorOrder || !$order) {
    $logger->info('TEMPLATE: No vendor order or order found - showing error message');
    echo '<div class="message error">Order not found or you do not have permission to view this order.</div>';
    return;
}

// Register order in registry for child blocks (Magento standard blocks expect this)
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$registry = $objectManager->get(\Magento\Framework\Registry::class);

// Unregister if already exists to avoid duplicate registry key error
if ($registry->registry('current_order')) {
    $registry->unregister('current_order');
}
$registry->register('current_order', $order);

// Also ensure vendor order is registered
if ($registry->registry('current_vendor_order')) {
    $registry->unregister('current_vendor_order');
}
$registry->register('current_vendor_order', $vendorOrder);
$logger->info('TEMPLATE: Registry updated');
?>
<div class="vendor-order-view">
    <?= $block->getChildHtml('vendor_order_actions') ?>

    <div class="order-details-items ordered">
        <div class="order-title">
            <strong><?= $block->escapeHtml(__('Items Ordered')) ?></strong>
