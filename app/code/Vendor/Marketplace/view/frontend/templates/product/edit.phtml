                            <script>
                                // Global helper for variations weight parsing
                                window.parseWeightFromLabel = function (label) {
                                    if (!label) return 1.0;
                                    var cleanLabel = label.toLowerCase();
                                    var weightMatch = cleanLabel.match(/(\d+(?:\.\d+)?)\s*(g|kg|gm|gram|lb|lbs|oz)/);
                                    if (weightMatch) {
                                        var value = parseFloat(weightMatch[1]);
                                        var unit = weightMatch[2];
                                        if (unit === 'g' || unit === 'gm' || unit === 'gram') {
                                            return value / 1000;
                                        }
                                        return value;
                                    }
                                    // Just numbers
                                    var numMatch = cleanLabel.match(/^(\d+(?:\.\d+)?)$/);
                                    if (numMatch) return parseFloat(numMatch[1]);
                                    return 1.0;
                                };
                            </script>

