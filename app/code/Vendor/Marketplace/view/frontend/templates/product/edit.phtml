                                            ));

                                            // Price
                                            row.append($('<td>').append(
                                                $('<input>').attr({ type: 'number', class: 'input-text edit-price', value: item.price, step: '0.01', readonly: true }).css('width', '80px').css('background', '#f8f8f8').css('cursor', 'not-allowed')
                                            ));


                                            // Weight
                                            var displayedWeight = item.weight;
                                            if (displayedWeight == 1.0 && item.attributes) {
                                                // Try to guess a better weight from attribute labels
                                                var guessed = parseWeightFromLabel(item.attributes);
                                                if (guessed != 1.0) displayedWeight = guessed;
                                            }

                                            row.append($('<td>').append(
                                                $('<input>').attr({ type: 'number', class: 'input-text edit-weight', value: displayedWeight, step: '0.01', readonly: true }).css('width', '80px').css('background', '#f8f8f8').css('cursor', 'not-allowed')
