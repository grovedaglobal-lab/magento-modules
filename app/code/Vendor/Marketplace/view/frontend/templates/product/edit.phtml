                                            var removeBtn = slot.parentElement.querySelector('.remove-slot-img');

                                            reader.onload = function (e) {
                                                slot.innerHTML = '<img src="' + e.target.result + '" style="max-width:100%; max-height:100%; object-fit:cover;" />';
                                                removeBtn.style.display = 'flex';
                                            }
                                            reader.readAsDataURL(input.files[0]);
                                        }
                                    }
                                    function removeSlotImage(index) {
                                        var input = document.getElementById('input-' + index);
                                        var slot = document.getElementById('slot-' + index);
                                        var removeBtn = slot.parentElement.querySelector('.remove-slot-img');

                                        input.value = '';
                                        slot.innerHTML = '<div class="box-content" style="text-align:center; padding:10px;"><i class="fas fa-camera" style="font-size:24px; color:#ccc; display:block; margin-bottom:5px;"></i><span class="text" style="font-size:10px; color:#007bdb;">' + (index == 1 ? '<?= __('Main Image') ?>' : '<?= __('Image ') ?>' + index) + '</span></div>';
                                        removeBtn.style.display = 'none';
                                    }
                                    function addVideoLink() {
                                        document.getElementById('video-slot-container').style.display = 'block';
                                        document.querySelector('.action-add-video').disabled = true;
                                        document.querySelector('.action-add-video').style.opacity = '0.5';
                                    }
                                    function removeVideoSlot() {
                                        document.getElementById('video-slot-container').style.display = 'none';
                                        document.getElementsByName('product[video_url]')[0].value = '';
                                        document.querySelector('.action-add-video').disabled = false;
                                        document.querySelector('.action-add-video').style.opacity = '1';
                                    }
