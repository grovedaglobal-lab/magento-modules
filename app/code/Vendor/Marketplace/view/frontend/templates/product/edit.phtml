                    </div>
                <?php endforeach; ?>

                <!-- Fallback for Images if no "Image" group exists (e.g. Default set might not group them nicely) -->
                <!-- For now assuming getting sorted attributes covers most needs. -->
            </div>

        </form>
    </div>
<?php endif; ?>

<script>
    require([
        'jquery',
        'mage/validation'
    ], function ($) {
        'use strict';

        console.log("Vendor Marketplace: Wizard Script Initializing...");

        var dataForm = $('#product-edit-form');
        var loadedOptions = [];
        var step3OriginalHtml = null;

        // Wizard Navigation
        window.goToStep = function (step) {
            // Validation before moving
            if (step === 2) {
                if (!$('#config-variation-attribute').val()) {
                    alert('<?= __('Please select an attribute.') ?>');
                    return;
                }
                // Hide Step 1 immediately to prevent stacking
                $('#step-1').removeClass('active');

                loadAttributeValues($('#config-variation-attribute').val());
            }
            if (step === 3) {
                if ($('#attribute-values-container input:checked').length === 0) {
                    alert('<?= __('Please select at least one value.') ?>');
                    return;
                }
            }

            // UI Update
            $('.wizard-step-content').removeClass('active').hide(); // Force hide
            $('#step-' + step).addClass('active').show(); // Force show

            $('.wizard-steps .step').removeClass('active');
            $('.wizard-steps .step[data-step="' + step + '"]').addClass('active');
        };

        // Load Values AJAX
        function loadAttributeValues(attributeId) {
            var container = $('#attribute-values-container');
            var loader = container.find('.loader');
            var msg = container.find('.no-values-msg');

            // Clear previous (except loader/msg)
            container.find('.value-item').remove();
            loader.show();
            msg.hide();

            $.ajax({
                url: '<?= $block->getUrl("marketplace/product/attributeOptions") ?>',
                type: 'GET',
                data: { attribute_id: attributeId },
                dataType: 'json',
                success: function (response) {
                    loader.hide();
                    if (response.success && response.options.length > 0) {
                        loadedOptions = response.options;
                        var html = '';
                        $.each(response.options, function (i, opt) {
                            html += '<div class="value-item" style="padding:5px; border-bottom:1px solid #eee;">';
                            html += '<label style="cursor:pointer; display:flex; align-items:center;">';
                            html += '<input type="checkbox" name="selected_values[]" value="' + opt.value + '" data-label="' + opt.label + '" style="margin-right:10px;">';
                            html += '<span>' + opt.label + '</span>';
                            html += '</label></div>';
                        });
                        container.append(html);
                    } else {
                        container.append('<div class="value-item">' + (response.message || '<?= __('No values found.') ?>') + '</div>');
                    }
                },
                error: function (xhr, status, error) {
                    loader.hide();
                    console.error("AJAX Error:", status, error);
                    alert('Error loading values: ' + error + ' (Status: ' + xhr.status + ')');
                    container.append('<div class="value-item"><?= __('Error loading values.') ?></div>');
                }
            });
        }

        window.selectAllValues = function () {
            $('#attribute-values-container input[type="checkbox"]').prop('checked', true);
        };
        window.deselectAllValues = function () {
            $('#attribute-values-container input[type="checkbox"]').prop('checked', false);
        };

        // Generate Variations AJAX
        window.generateVariations = function () {
            var attributeId = $('#config-variation-attribute').val();
            var optionSelected = $('#config-variation-attribute option:selected');
            var attributeLabel = optionSelected.data('label');
            var attributeCode = optionSelected.data('code');

            var selectedValues = [];
            $('#attribute-values-container input:checked').each(function () {
                selectedValues.push({
                    value: $(this).val(),
                    label: $(this).data('label')
                });
            });

            if (selectedValues.length === 0) {
                alert('<?= __('Please select at least one attribute value.') ?>');
                return;
            }

            var baseName = $('input[name="product[name]"]').val();
            var baseSku = $('input[name="product[sku]"]').val();

            if (!baseName || !baseSku) {
                alert('<?= __('Please enter Product Name and SKU in the main form first.') ?>');
                return;
            }

            // Check if unique pricing/quantity is selected
            var priceOption = $('input[name="price_option"]:checked').val();
            var qtyOption = $('input[name="qty_option"]:checked').val();

            if (priceOption === 'unique' || qtyOption === 'unique') {
                // Show individual input fields for each attribute value
                showUniqueInputs(selectedValues, priceOption, qtyOption, attributeId, attributeCode, baseName, baseSku);
            } else {
                // Proceed with bulk generation
                var bulkPrice = $('#bulk-price').val();
                var bulkQty = $('#bulk-qty').val();
                proceedWithGeneration(attributeId, attributeCode, selectedValues, bulkPrice, bulkQty, baseName, baseSku);
            }
        };

        // Show unique input fields for each attribute value
        function showUniqueInputs(selectedValues, priceOption, qtyOption, attributeId, attributeCode, baseName, baseSku) {
            if (step3OriginalHtml === null) {
                step3OriginalHtml = $('#step-3').html();
            }

            var html = '<h4><?= __('Set Individual Prices and Quantities') ?></h4>';
            html += '<p><?= __('Enter price and quantity for each variation:') ?></p>';
            html += '<div class="unique-inputs-container" style="max-height:400px; overflow-y:auto;">';
            html += '<table class="data table" style="width:100%;">';
            html += '<thead><tr>';
            html += '<th><?= __('Attribute Value') ?></th>';
            if (priceOption === 'unique') html += '<th><?= __('Price') ?></th>';
            if (qtyOption === 'unique') html += '<th><?= __('Quantity') ?></th>';
            html += '</tr></thead><tbody>';

            $.each(selectedValues, function (i, opt) {
                html += '<tr>';
                html += '<td><strong>' + opt.label + '</strong></td>';
                if (priceOption === 'unique') {
                    html += '<td><input type="number" class="input-text unique-price" data-value="' + opt.value + '" placeholder="<?= __('Price') ?>" style="width:100%;"/></td>';
                }
                if (qtyOption === 'unique') {
                    html += '<td><input type="number" class="input-text unique-qty" data-value="' + opt.value + '" placeholder="<?= __('Quantity') ?>" style="width:100%;"/></td>';
                }
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            html += '<div class="note" style="margin-top:10px; color:#666;">';
            if (priceOption === 'unique' && qtyOption !== 'unique') {
                html += '<?= __('Only unique price is enabled for this step.') ?>';
            } else if (qtyOption === 'unique' && priceOption !== 'unique') {
                html += '<?= __('Only unique quantity is enabled for this step.') ?>';
            }
            html += '</div>';
            html += '<div class="wizard-actions" style="margin-top:20px;">';
            html += '<button type="button" class="action secondary" onclick="restoreStep3AndGoBack()"><?= __('Back') ?></button>';
            html += '<button type="button" class="action primary" id="confirm-unique-generation"><?= __('Generate Products') ?></button>';
            html += '</div>';

            // Replace Step 3 content temporarily
            $('#step-3').html(html);

            // Bind click event for confirmation
            $('#confirm-unique-generation').on('click', function () {
                var uniquePrices = {};
                var uniqueQtys = {};
                var hasValidationErrors = false;

                // Collect unique prices
                if (priceOption === 'unique') {
                    $('.unique-price').each(function () {
                        var val = $(this).data('value');
                        var price = $(this).val();
                        if (!price || price <= 0) {
                            alert('<?= __('Please enter a valid price for all variations.') ?>');
                            hasValidationErrors = true;
                            return false;
                        }
                        uniquePrices[val] = price;
                    });
                }

                // Collect unique quantities
                if (qtyOption === 'unique') {
                    $('.unique-qty').each(function () {
                        var val = $(this).data('value');
                        var qty = $(this).val();
                        if (!qty || qty < 0) {
                            alert('<?= __('Please enter a valid quantity for all variations.') ?>');
                            hasValidationErrors = true;
                            return false;
                        }
                        uniqueQtys[val] = qty;
                    });
                }

                if (hasValidationErrors) {
                    return;
                }

                // Proceed with generation using unique values
                proceedWithUniqueGeneration(attributeId, attributeCode, selectedValues, uniquePrices, uniqueQtys, baseName, baseSku, priceOption, qtyOption);
            });
        }

        window.restoreStep3AndGoBack = function () {
            if (step3OriginalHtml !== null) {
                $('#step-3').html(step3OriginalHtml);
            }
            goToStep(3);
        };

        window.enableCurrentVariations = function () {
            if (typeof jQuery === 'undefined') {
                return;
            }

            var grid = jQuery('#current-variations-grid tbody');
            if (!grid.length) {
                return;
            }

            grid.find('tr').each(function () {
                var row = jQuery(this);
                var imageCell = row.children('td').eq(0);
                var imageBox = imageCell.find('.placeholder-img');
                var imageInput = imageCell.find('input[type="file"]');

                imageBox.css({ 'cursor': 'pointer', 'opacity': '1' }).attr('onclick', 'this.nextElementSibling.click()');
                imageInput.prop('disabled', false).show();

                row.find('.edit-name, .edit-sku, .edit-price, .edit-weight, .edit-qty')
                    .prop('readonly', false)
                    .css({ 'background': '', 'cursor': '' });
            });
        };

        // Proceed with bulk generation
        function proceedWithGeneration(attributeId, attributeCode, selectedValues, bulkPrice, bulkQty, baseName, baseSku) {
            // Show loading or disable button
            $('#step-3 .next-step').text('<?= __('Generating...') ?>').attr('disabled', true);

            $.ajax({
                url: '<?= $block->getUrl("marketplace/product/variationGenerate") ?>',
                type: 'POST',
                data: {
                    attribute_id: attributeId,
                    attribute_code: attributeCode,
                    options: selectedValues,
                    bulk_price: bulkPrice,
                    bulk_qty: bulkQty,
                    name: baseName,
                    sku: baseSku,
                    set_id: $('input[name="set"]').val()
                },
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        // Populate Grid
                        var tbody = $('#generated-products-grid tbody');
                        tbody.empty();

                        var linkedProducts = [];

                        $.each(response.products, function (i, prod) {
                            var row = '<tr data-product-id="' + (prod.id || '') + '" data-attribute-id="' + prod.attribute_id + '" data-option-id="' + prod.option_id + '">';
                            // Image placeholder with file input
                            row += '<td><div class="placeholder-img" style="width:50px; height:50px; background:#eee; border:1px solid #ccc; display:flex; align-items:center; justify-content:center; cursor:pointer;" onclick="this.nextElementSibling.click()"><span><i class="fas fa-camera"></i></span></div>';
                            row += '<input type="file" name="variation_image_new_' + i + '" class="edit-image" style="display:none;" onchange="previewVariationImage(this)" /></td>';
                            // Editable Name
                            row += '<td><input type="text" class="input-text edit-name" value="' + prod.name + '" style="width:100%;" required /></td>';
                            // Editable SKU
                            row += '<td><input type="text" class="input-text edit-sku" value="' + prod.sku + '" style="width:100%;" required /></td>';
                            var priceVal = prod.price || '0.00';
                            row += '<td><input type="number" class="input-text edit-price" value="' + priceVal + '" placeholder="0.00" step="0.01" min="0" style="width:100%;" /></td>';
                            // Editable Weight
                            var weightVal = prod.weight || parseWeightFromLabel(prod.attribute_value);
                            row += '<td><input type="number" class="input-text edit-weight" value="' + weightVal + '" placeholder="1.00" step="0.01" min="0" style="width:100%;" /></td>';
                            // Editable Quantity
                            var qtyVal = (prod.qty !== null && prod.qty !== undefined && prod.qty !== '') ? prod.qty : '';
                            row += '<td><input type="number" class="input-text edit-qty" value="' + qtyVal + '" placeholder="0" min="0" style="width:100%;" /></td>';
                            // Attribute (read-only)
                            row += '<td>' + prod.attribute_value + '</td>';
                            row += '</tr>';
                            tbody.append(row);

                            linkedProducts.push({
                                product_id: prod.id,
                                sku: prod.sku,
                                name: prod.name,
                                price: prod.price,
                                qty: prod.qty,
                                attributes: [
                                    {
                                        attribute_id: prod.attribute_id,
                                        value: prod.option_id
                                    }
                                ]
                            });
                        });

                        // Set Hidden Field for Save
                        var configData = {
                            'attribute_id': attributeId,
                            'linked_products': linkedProducts
                        };
                        $('#configurable_products_data').val(JSON.stringify(configData));

                        goToStep(4);
                    } else {
                        alert(response.message || '<?= __('Error generating variations.') ?>');
                        $('#step-3 .next-step').text('<?= __('Generate Products') ?>').attr('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    alert('<?= __('System error generating variations.') ?>: ' + error);
                    $('#step-3 .next-step').text('<?= __('Generate Products') ?>').attr('disabled', false);
                }
            });
        }

        // Proceed with unique generation
        function proceedWithUniqueGeneration(attributeId, attributeCode, selectedValues, uniquePrices, uniqueQtys, baseName, baseSku, priceOption, qtyOption) {
            // Show loading
            $('#confirm-unique-generation').text('<?= __('Generating...') ?>').attr('disabled', true);

            // Prepare options with unique prices/quantities
            var optionsWithPricing = [];
            $.each(selectedValues, function (i, opt) {
                optionsWithPricing.push({
                    value: opt.value,
                    label: opt.label,
                    price: priceOption === 'unique' ? uniquePrices[opt.value] : null,
                    qty: qtyOption === 'unique' ? uniqueQtys[opt.value] : null
                });
            });

            $.ajax({
                url: '<?= $block->getUrl("marketplace/product/variationGenerate") ?>',
                type: 'POST',
                data: {
                    attribute_id: attributeId,
                    attribute_code: attributeCode,
                    options: optionsWithPricing,
                    unique_pricing: priceOption === 'unique',
                    unique_qty: qtyOption === 'unique',
                    name: baseName,
                    sku: baseSku,
                    set_id: $('input[name="set"]').val()
                },
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        // Populate Grid
                        var tbody = $('#generated-products-grid tbody');
                        tbody.empty();

                        var linkedProducts = [];

                        $.each(response.products, function (i, prod) {
                            var row = '<tr data-product-id="' + (prod.id || '') + '" data-attribute-id="' + attributeId + '" data-option-id="' + prod.option_id + '">';
                            row += '<td><div class="placeholder-img" style="width:50px; height:50px; background:#eee; border:1px solid #ccc; display:flex; align-items:center; justify-content:center; cursor:pointer;" onclick="this.nextElementSibling.click()"><span><i class="fas fa-camera"></i></span></div>';
                            row += '<input type="file" name="variation_image_new_' + i + '" class="edit-image" style="display:none;" onchange="previewVariationImage(this)" /></td>';
                            row += '<td><input type="text" class="input-text edit-name" value="' + prod.name + '" style="width:100%;" required /></td>';
                            row += '<td>' + prod.sku + '</td>';
                            row += '<td>' + prod.price + '</td>';
                            row += '<td>' + ((prod.weight !== null && prod.weight !== undefined) ? prod.weight : parseWeightFromLabel(prod.attribute_value)) + '</td>';
                            row += '<td>' + ((prod.qty !== null && prod.qty !== undefined) ? prod.qty : '') + '</td>';
                            row += '<td>' + prod.attribute_value + '</td>';
                            row += '</tr>';
                            tbody.append(row);

                            linkedProducts.push({
                                product_id: prod.id,
                                sku: prod.sku
                            });
                        });

                        // Set Hidden Field for Save
                        var configData = {
                            'attribute_id': attributeId,
                            'linked_products': linkedProducts
                        };
                        $('#configurable_products_data').val(JSON.stringify(configData));

                        goToStep(4);
                    } else {
                        alert(response.message || '<?= __('Error generating variations.') ?>');
                        $('#confirm-unique-generation').text('<?= __('Generate Products') ?>').attr('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    alert('<?= __('System error generating variations.') ?>: ' + error);
                    $('#confirm-unique-generation').text('<?= __('Generate Products') ?>').attr('disabled', false);
                }
            });
        }


        // Check if product actually has children (variations)
        <?php
        $hasChildren = false;
        if ($product->getTypeId() === 'configurable') {
            $children = $product->getTypeInstance()->getUsedProducts($product);
            if (count($children) > 0) {
                $hasChildren = true;
            }
        }
        ?>
        var hasChildren = <?= $hasChildren ? 'true' : 'false' ?>;

        // Form Submit Handler
        dataForm.on('submit', function () {
            if ($('#product-edit-form input[name="type"]').val() === 'configurable') {

                // Auto-save grid variations if they exist (Step 4 or Current)
                if ($('#generated-products-grid tbody tr').length > 0 || $('#current-variations-grid tbody tr').length > 0) {
                    saveAllVariations(true); // pass true to suppress alerts
                }

                var configData = $('#configurable_products_data').val();

                // Require wizard if:
                // 1. It's a NEW product (no ID) OR
                // 2. It's an EXISTING product but has NO children (e.g. failed creation)
                // AND
                // 3. No new config data has been generated yet
                if ((!hasChildren) && !configData) {
                    alert('<?= __('This Configurable Product has no variations. Please use the wizard to generate them before saving.') ?>');
                    return false;
                }
            }
            return true;
        });

        // Initialize Validation
        dataForm.mage('validation', {
            ignore: ':hidden:not(.accordion-content .required-entry, .accordion-content .validate-number, .accordion-content .validate-code, .accordion-content select, .accordion-content textarea, .accordion-content input)',
            errorPlacement: function (error, element) {
                error.insertAfter(element);
                var accordion = $(element).closest('.accordion-content');
                if (accordion.length) {
                    var title = accordion.prev('.accordion-title');
                    if (!title.hasClass('active')) {
                        title.addClass('active');
                        accordion.slideDown();
                    }
                }
            }
        });

        // Save all edited variations
        function saveAllVariations(suppressAlerts = false) {
            var generatedRows = $('#generated-products-grid tbody tr');
            var currentRows = $('#current-variations-grid tbody tr');
            var updates = [];
            var hasErrors = false;

            // Helper to collect data from a row
            function collectRowData(row) {
                var productId = row.data('product-id');
                var imageCell = row.children('td').eq(0);
                var imageInput = row.find('input[type="file"]');
                var nameInput = row.find('.edit-name');
                var skuInput = row.find('.edit-sku');
                var priceInput = row.find('.edit-price');
                var weightInput = row.find('.edit-weight');
                var qtyInput = row.find('.edit-qty');

                // Support both input-based rows and read-only text-cell rows.
                var name = nameInput.length ? (nameInput.val() ? nameInput.val().trim() : '') : $.trim(row.children('td').eq(1).text());
                var sku = skuInput.length ? (skuInput.val() ? skuInput.val().trim() : '') : $.trim(row.children('td').eq(2).text());
                var price = priceInput.length ? priceInput.val() : $.trim(row.children('td').eq(3).text());
                var weight = weightInput.length ? weightInput.val() : $.trim(row.children('td').eq(4).text());
                var qty = qtyInput.length ? qtyInput.val() : $.trim(row.children('td').eq(5).text());
                var hasImage = imageCell.find('img').length > 0 || (imageInput.length && imageInput[0].files && imageInput[0].files.length > 0);

                // Validate required fields
                if (!name || !sku) {
                    hasErrors = true;
                    if (!name && nameInput.length) {
                        nameInput.css('border', '2px solid red');
                    }
                    if (!sku && skuInput.length) {
                        skuInput.css('border', '2px solid red');
                    }
                    return null;
                }

                if (!hasImage) {
                    hasErrors = true;
                    imageCell.css('outline', '2px solid red');
                    return null;
                }

                // Reset borders
                if (nameInput.length) {
                    nameInput.css('border', '');
                }
                if (skuInput.length) {
                    skuInput.css('border', '');
                }
                imageCell.css('outline', '');

                var attrId = row.data('attribute-id');
                var optId = row.data('option-id');

                var fileInput = row.find('input[type="file"]');
                var fileKey = fileInput.length ? fileInput.attr('name') : null;

                var data = {
                    name: name,
                    sku: sku,
                    price: price || 0,
                    weight: weight || 0,
                    qty: qty || 0,
                    file_key: fileKey
                };

                if (productId) {
                    data.product_id = productId;
                }

                if (attrId && optId) {
                    data.attributes = [
                        {
                            attribute_id: attrId,
                            value: optId
                        }
                    ];
                }

                if (weight !== undefined) {
                    data.weight = weight;
                }

                return data;
            }

            // Collect from Generated Grid
            generatedRows.each(function () {
                var data = collectRowData($(this));
                if (data) updates.push(data);
            });

            // Collect from Current Variations Grid
            currentRows.each(function () {
                var data = collectRowData($(this));
                if (data) updates.push(data);
            });

            if (hasErrors) {
                if (!suppressAlerts) alert('<?= __('Please fill in all required fields (Name and SKU).') ?>');
                return;
            }

            // Update Hidden Field with Edited Data
            var currentConfigData = $('#configurable_products_data').val();
            if (currentConfigData) {
                try {
                    var configJson = JSON.parse(currentConfigData);
                    // Merge or replace? We should probably just append or replace linked_products
                    // But wait, if we have existing data in configJson, we want to update it.
                    // Ideally, we just send a flat list of all variations to be processed by Save.php
                    configJson.linked_products = updates;
                    $('#configurable_products_data').val(JSON.stringify(configJson));
                } catch (e) {
                    $('#configurable_products_data').val(JSON.stringify({
                        linked_products: updates
                    }));
                }
            } else {
                $('#configurable_products_data').val(JSON.stringify({
                    linked_products: updates
                }));
            }

            // Visual feedback
            if (!suppressAlerts) {
                // Update button text for both grids if they exist
                $('#step-4 .action.primary').text('<?= __('Saved! Click "Save Product" below') ?>');
                $('#step-4 .action.primary').css('background', '#28a745').css('border-color', '#28a745');

                alert('<?= __('Variations data updated! Please click "Save Product" at the top or bottom of the page to persist changes to the database.') ?>');

                setTimeout(function () {
                    if (!suppressAlerts) {
                        $('#step-4 .action.primary').text('<?= __('Save All Variations') ?>').css('background', '').css('border-color', '');
                    }
                }, 5000);
            }
        }

        // Auto-save variations on form submit to ensure all grid edits are captured
        require(['jquery'], function ($) {
            $('#product-edit-form').on('submit', function (e) {
                // Image Validation: Ensure at least 1 image is uploaded or already exists
                var hasMainImage = false;
                $('.media-slot').each(function () {
                    var img = $(this).find('img');
                    var input = $(this).find('input[type="file"]')[0];
                    if (img.length > 0 || (input && input.files && input.files.length > 0)) {
                        hasMainImage = true;
                        return false; // Break the each loop
                    }
                });

                if (!hasMainImage) {
                    alert('<?= __('Please upload at least one image for the product before saving.') ?>');
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                }

                if ($('#generated-products-grid').length || $('#current-variations-grid').length) {
                    saveAllVariations(true); // Suppress alerts
                }
            });
        });

        // Make saveAllVariations available globally for onclick
        window.saveAllVariations = saveAllVariations;

        window.previewVariationImage = function (input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var placeholder = input.previousElementSibling;
                    if (placeholder && placeholder.classList.contains('placeholder-img')) {
                        placeholder.innerHTML = '<img src="' + e.target.result + '" style="max-width:100%;max-height:100%;">';
                    } else if (typeof jQuery !== 'undefined') {
                        jQuery(input).prev('.placeholder-img').html('<img src="' + e.target.result + '" style="max-width:100%;max-height:100%;">');
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        };

        // Accordion toggle function
        window.toggleAccordion = function (element) {
            if (typeof jQuery !== 'undefined') {
                jQuery(element).toggleClass('active');
                jQuery(element).next('.accordion-content').slideToggle();
            }
        };

        // Open the configuration wizard and reset to Step 1
        window.openConfigurationWizard = function () {
            if (typeof jQuery !== 'undefined') {
                var wizard = jQuery('#configurable-product-wizard');
                wizard.stop(true, true).slideDown();
                jQuery('.wizard-step-content').hide();
                jQuery('#step-1').show().addClass('active');
                jQuery('.wizard-steps .step').removeClass('active');
                jQuery('.wizard-steps .step[data-step="1"]').addClass('active');

                if (wizard.length && wizard[0].scrollIntoView) {
                    wizard[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        };

        // Backward compatibility if any old calls still exist
        window.toggleWizard = window.openConfigurationWizard;

        console.log("Vendor Marketplace: Wizard Script Initialization Complete");

        // Initial State Fix
        $('.wizard-step-content').hide();
        $('#step-1').show();
    });
</script>

