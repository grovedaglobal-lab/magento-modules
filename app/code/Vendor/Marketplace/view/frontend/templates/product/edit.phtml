                                                    style="position:absolute; top:-5px; right:-5px; background:#fff; border:1px solid #ccc; border-radius:50%; width:20px; height:20px; display:<?= $existingImage ? 'flex' : 'none' ?>; align-items:center; justify-content:center; cursor:pointer; z-index:10;">&times;</button>
