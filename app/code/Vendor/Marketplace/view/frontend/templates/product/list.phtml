<script>
    /* â”€â”€â”€ Panel Toggle Logic â”€â”€â”€ */
    var openPanel = null;
    var openBtn   = null;

    function togglePanel(panelId, btnId) {
        var panel = document.getElementById(panelId);
        var btn   = document.getElementById(btnId);

        if (openPanel && openPanel !== panel) {
            openPanel.classList.remove('panel-visible');
            if (openBtn) openBtn.classList.remove('panel-open');
        }

        if (panel.classList.contains('panel-visible')) {
            panel.classList.remove('panel-visible');
            btn.classList.remove('panel-open');
            openPanel = null;
            openBtn   = null;
        } else {
            panel.classList.add('panel-visible');
            btn.classList.add('panel-open');
            openPanel = panel;
            openBtn   = btn;
        }
    }

    function closePanel(panelId, btnId) {
        var panel = document.getElementById(panelId);
        var btn   = document.getElementById(btnId);
        if (panel) panel.classList.remove('panel-visible');
        if (btn)   btn.classList.remove('panel-open');
        openPanel = null;
        openBtn   = null;
    }

    /* â”€â”€â”€ Filters â”€â”€â”€ */
    function applyFiltersPanel() {
        var url    = '<?= $block->getUrl('*/*/*') ?>';
        var params = [];
        var fields = ['fp-keyword', 'fp-name', 'fp-sku', 'fp-status'];
        var names  = ['keyword', 'name', 'sku', 'status'];

        fields.forEach(function(id, i) {
            var el = document.getElementById(id);
            if (el && el.value) {
                params.push(names[i] + '=' + encodeURIComponent(el.value));
            }
        });

        window.location.href = params.length ? url + '?' + params.join('&') : url;
    }

    function clearFilters() {
        window.location.href = '<?= $block->getUrl('*/*/*') ?>';
    }

    /* â”€â”€â”€ Default View Options â”€â”€â”€ */
    function selectViewOption(view) {
        document.querySelectorAll('.view-option').forEach(function(el) {
            el.classList.remove('active-view');
        });
        var targetRadio = document.querySelector('input[name="grid-view"][value="' + view + '"]');
        if (targetRadio) {
            targetRadio.checked = true;
            targetRadio.closest('.view-option').classList.add('active-view');
        }
    }

    function applyView() {
        var selected = document.querySelector('input[name="grid-view"]:checked');
        if (selected) {
            localStorage.setItem('product-grid-view', selected.value);
            var wrapper = document.getElementById('products-table-wrapper');
            if (selected.value === 'compact') {
                wrapper.classList.add('table-compact');
            } else {
                wrapper.classList.remove('table-compact');
            }
        }
        closePanel('default-view-panel', 'btn-default-view');
    }

    // Load saved view on page load
    (function initView() {
        var savedView = localStorage.getItem('product-grid-view') || 'default';
        selectViewOption(savedView);
        var wrapper = document.getElementById('products-table-wrapper');
        if (wrapper && savedView === 'compact') {
            wrapper.classList.add('table-compact');
        }
    })();

    /* â”€â”€â”€ Columns Toggle â”€â”€â”€ */
    function applyColumns() {
        var checkboxes = document.querySelectorAll('.col-toggle input[data-col]');
        var hiddenCols = [];
        checkboxes.forEach(function(cb) {
            var colClass = cb.getAttribute('data-col');
            var cells = document.querySelectorAll('.' + colClass);
            cells.forEach(function(cell) {
                cell.style.display = cb.checked ? '' : 'none';
            });
            if (!cb.checked) {
                hiddenCols.push(colClass);
            }
        });
        localStorage.setItem('product-hidden-cols', JSON.stringify(hiddenCols));
        closePanel('columns-panel', 'btn-columns');
    }

    function resetColumns() {
        var checkboxes = document.querySelectorAll('.col-toggle input[data-col]');
        checkboxes.forEach(function(cb) {
            cb.checked = true;
        });
        localStorage.removeItem('product-hidden-cols');
        applyColumns();
    }

    // Restore column visibility
    (function initColumns() {
        try {
            var hiddenCols = JSON.parse(localStorage.getItem('product-hidden-cols') || '[]');
            hiddenCols.forEach(function(colClass) {
                var cb = document.querySelector('.col-toggle input[data-col="' + colClass + '"]');
                if (cb) cb.checked = false;
                var cells = document.querySelectorAll('.' + colClass);
                cells.forEach(function(cell) {
                    cell.style.display = 'none';
                });
            });
        } catch (e) {}
    })();

    /* â”€â”€â”€ Outside Click to Close Panels â”€â”€â”€ */
    document.addEventListener('click', function(e) {
        if (!openPanel) return;
        var inPanel = openPanel.contains(e.target);
        var inBtn   = openBtn && openBtn.contains(e.target);
        if (!inPanel && !inBtn) {
            openPanel.classList.remove('panel-visible');
            if (openBtn) openBtn.classList.remove('panel-open');
            openPanel = null;
            openBtn   = null;
        }
    });

    /* â”€â”€â”€ Variant Toggling â”€â”€â”€ */
    function toggleVariants(parentId, btn) {
        var rows = document.querySelectorAll('.child-of-' + parentId);
        var isHidden = false;
        rows.forEach(function (row) {
            if (row.style.display === 'none') {
                row.style.display = '';
                isHidden = false;
            } else {
                row.style.display = 'none';
                isHidden = true;
            }
        });
        var icon = btn.querySelector('i');
        if (icon) {
            icon.className = isHidden ? 'fas fa-chevron-right' : 'fas fa-chevron-down';
        }
    }

    /* â”€â”€â”€ Actions Handlers â”€â”€â”€ */
    function handleRowAction(select, editUrl, deleteUrl) {
        var val = select.value;
        select.value = "";
        if (val === 'edit') {
            window.location.href = editUrl;
        } else if (val === 'delete') {
            if (confirm('<?= __('Are you sure you want to delete this product?') ?>')) {
                window.location.href = deleteUrl;
            }
        }
    }

    function handleMassAction(select) {
        if (select.value === 'delete') {
            var checkboxes = document.querySelectorAll('input[name="product_ids[]"]:checked');
            if (checkboxes.length === 0) {
                alert('<?= __('Please select at least one product.') ?>');
                select.value = "";
                return;
            }
            if (confirm('<?= __('Are you sure you want to delete selected products?') ?>')) {
                document.getElementById('product-grid-form').submit();
            } else {
                select.value = "";
            }
        }
    }

    function toggleAll(source) {
        var checkboxes = document.getElementsByName('product_ids[]');
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = source.checked;
        }
    }
</script>

