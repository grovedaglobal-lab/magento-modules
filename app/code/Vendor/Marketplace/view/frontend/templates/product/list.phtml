<script>
    function toggleFilters() {
        var el = document.getElementById('grid-filters');
        el.style.display = (el.style.display === 'none') ? 'block' : 'none';
    }



    function handleRowAction(select, editUrl, deleteUrl) {
        var val = select.value;
        select.value = ""; // Reset selection

        if (val === 'edit') {
            window.location.href = editUrl;
        } else if (val === 'delete') {
            if (confirm('<?= __('Are you sure you want to delete this product?') ?>')) {
                window.location.href = deleteUrl;
            }
        }
    }



    function handleMassAction(select) {
        if (select.value === 'delete') {
            if (confirm('<?= __('Are you sure you want to delete selected products?') ?>')) {
                document.getElementById('product-grid-form').submit();
            } else {
                select.value = ""; // Reset if cancelled
            }
        }
    }

    function toggleAll(source) {
        var checkboxes = document.getElementsByName('product_ids[]');
        for (var i = 0, n = checkboxes.length; i < n; i++) {
            checkboxes[i].checked = source.checked;
        }
    }

    // Close dropdowns if clicked outside
    window.onclick = function (event) {
        if (!event.target.closest('.actions-dropdown-wrapper') && !event.target.closest('.row-actions-wrapper')) {
            var dropdowns = document.getElementsByClassName("actions-menu");
            for (var i = 0; i < dropdowns.length; i++) {
                dropdowns[i].style.display = 'none';
            }
            var rowDropdowns = document.getElementsByClassName("row-actions-menu");
            for (var i = 0; i < rowDropdowns.length; i++) {
                rowDropdowns[i].style.display = 'none';
            }
        }
    }
</script>