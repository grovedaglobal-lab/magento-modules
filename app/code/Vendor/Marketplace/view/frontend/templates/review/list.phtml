        <h2><?= __('Product Reviews') ?></h2>
        <div class="review-stats-badge">
            <?= __('Total: %1', $count) ?>
        </div>
    </div>

    <div class="reviews-table-wrapper">
        <table class="reviews-table">
            <thead>
                <tr>
                    <th class="col-date"><?= __('Date') ?></th>
                    <th class="col-product"><?= __('Product') ?></th>
                    <th class="col-customer"><?= __('Customer') ?></th>
                    <th class="col-rating"><?= __('Rating') ?></th>
                    <th class="col-summary"><?= __('Review') ?></th>
                    <th class="col-status"><?= __('Status') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php if ($count > 0): ?>
                    <?php foreach ($collection as $review): ?>
                        <tr>
                            <td class="col-date">
                                <?= $block->escapeHtml(date('M d, Y', strtotime($review->getCreatedAt()))) ?>
                            </td>
                            <td class="col-product">
                                <?= $block->escapeHtml($review->getProductName() ?: __('N/A')) ?>
                            </td>
                            <td class="col-customer">
                                <?= $block->escapeHtml($review->getNickname()) ?>
                            </td>
                            <td class="col-rating">
                                <?php
                                $votes = $review->getRatingVotes();
                                $percent = 0;
                                if ($votes && count($votes)) {
                                    foreach ($votes as $vote) {
                                        $percent += (int) $vote->getPercent();
                                    }
                                    $percent = $percent / count($votes);
                                }
                                $stars = round($percent / 20);
                                ?>
                                <div class="star-rating" title="<?= $percent ?>%">
                                    <?php for ($i = 1; $i <= 5; $i++): ?>
                                        <svg class="<?= $i <= $stars ? 'filled' : '' ?>" viewBox="0 0 20 20">
                                            <path
                                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    <?php endfor; ?>
                                </div>
                            </td>
                            <td class="col-summary">
                                <span class="review-text-summary"><?= $block->escapeHtml($review->getTitle()) ?></span>
                                <div class="review-text-detail"><?= $block->escapeHtml($review->getDetail()) ?></div>
                            </td>
                            <td class="col-status">
                                <span
                                    class="status-badge status-<?= strtolower($block->getStatusLabel($review->getStatusId())) ?>">
                                    <?= $block->getStatusLabel($review->getStatusId()) ?>
                                </span>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php else: ?>
                    <tr>
                        <td colspan="6" class="no-data-msg">
                            <?= __('No reviews found for your products.') ?>
                        </td>
                    </tr>
                <?php endif; ?>
            </tbody>
        </table>
    </div>

    <?php if ($block->getPagerHtml()): ?>
        <div class="toolbar-bottom">
            <?= $block->getPagerHtml() ?>
        </div>
    <?php endif; ?>
</div>