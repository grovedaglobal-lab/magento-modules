<script>
    // Tab switching - plain JS, no framework dependency needed
    document.addEventListener('DOMContentLoaded', function () {
        var tabs = document.querySelectorAll('.control-tabs .tab');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                var target = this.getAttribute('data-target');

                // Toggle active tab
                tabs.forEach(function (t) { t.classList.remove('active'); });
                this.classList.add('active');

                // Toggle content panels
                document.querySelectorAll('.tab-content').forEach(function (panel) {
                    panel.style.display = 'none';
                });
                var activePanel = document.getElementById('dashboard-' + target);
                if (activePanel) {
                    activePanel.style.display = 'block';
                }
            });
        });
    });
</script>

<script>
    require(['chartjs'], function (Chart) {
        if (!document.getElementById('salesChart')) return;

        var chartData = <?= $chartData ?>;
        var labels = chartData.map(function (item) { return item.date; });
        var salesData = chartData.map(function (item) { return item.sales; });
        var ordersData = chartData.map(function (item) { return item.orders; });

        new Chart(document.getElementById('salesChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total Sales',
                    data: salesData,
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1, fill: true, tension: 0.4
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        new Chart(document.getElementById('ordersChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total Orders',
                    data: ordersData,
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1, fill: true, tension: 0.4
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    });
</script>