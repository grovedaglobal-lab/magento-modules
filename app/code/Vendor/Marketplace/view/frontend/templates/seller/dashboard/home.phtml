<script>
    require(['jquery', 'chartjs'], function ($, Chart) {
        // Period filter - reload page with selected period param
        document.getElementById('dashboard-period-select').addEventListener('change', function () {
            var url = new URL(window.location.href);
            url.searchParams.set('period', this.value);
            window.location.href = url.toString();
        });

        // Tab switching logic
        $('.dashboard-controls .tab').on('click', function (e) {
            e.preventDefault();
            var target = $(this).data('target');
            $('.dashboard-controls .tab').removeClass('active');
            $(this).addClass('active');

            if (target === 'reports') {
                $('#dashboard-reports-content').show();
                $('#dashboard-activities-content').hide();
            } else {
                $('#dashboard-reports-content').hide();
                $('#dashboard-activities-content').show();
            }
        });

        // Initialize Charts
        var rawData = <?= $chartData ?>;
        var labels = rawData.map(function (d) { return d.date; });
        var salesData = rawData.map(function (d) { return d.sales; });
        var ordersData = rawData.map(function (d) { return d.orders; });

        // Sales Chart (Bar)
        new Chart(document.getElementById('salesChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Sales',
                    data: salesData,
                    backgroundColor: '#4e73df',
                    borderRadius: 4
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: { beginAtZero: true, display: false }
                }
            }
        });

        // Orders Chart (Line/Area)
        new Chart(document.getElementById('ordersChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Orders',
                    data: ordersData,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78, 115, 223, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: { beginAtZero: true, display: false }
                }
            }
        });
    });
</script>