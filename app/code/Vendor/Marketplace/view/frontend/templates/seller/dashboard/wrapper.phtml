        <script>
            require(['jquery', 'mage/url'], function ($, urlBuilder) {
                const fetchUrl = '<?= $block->getUrl('vendor_marketplace/notification/fetch') ?>';
                const markReadUrl = '<?= $block->getUrl('vendor_marketplace/notification/markRead') ?>';
                let isDropdownOpen = false;

                function updateNotifications() {
                    $.ajax({
                        url: fetchUrl,
                        type: 'GET',
                        dataType: 'json',
                        success: function (data) {
                            if (data.success) {
                                // Update Badge
                                const count = data.count;
                                const $badge = $('#notif-badge');
                                if (count > 0) {
                                    $badge.text(count).show().addClass('has-unread');
                                } else {
                                    $badge.hide().removeClass('has-unread');
                                }

                                // Update List
                                const $list = $('#notif-list');
                                if (data.notifications && data.notifications.length > 0) {
                                    let html = '';
                                    data.notifications.forEach(function (notif) {
                                        html += `
                                            <a href="${notif.link}" class="notification-item">
                                                <span class="notif-title">${notif.title}</span>
                                                <span class="notif-message">${notif.message}</span>
                                                <span class="notif-time">${notif.created_at}</span>
                                            </a>
                                        `;
                                    });
                                    $list.html(html);
                                } else {
                                    $list.html('<div class="empty-notifications"><?= __('No new notifications') ?></div>');
                                }
                            }
                        }
                    });
                }

                // Initial fetch
                updateNotifications();

                // Poll every 60 seconds
                setInterval(updateNotifications, 60000);

                // Toggle Dropdown
                $('#notif-toggle').on('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $('#notif-dropdown').toggleClass('active');
                });

                // Close dropdown on outside click
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#notif-bell-container').length) {
                        $('#notif-dropdown').removeClass('active');
                    }
                });

                // Mark as read
                $('#mark-all-read').on('click', function () {
                    $.ajax({
                        url: markReadUrl,
                        type: 'POST',
                        dataType: 'json',
                        success: function (data) {
                            if (data.success) {
                                $('#notif-badge').hide().removeClass('has-unread');
                                $('#notif-list').html('<div class="empty-notifications"><?= __('No new notifications') ?></div>');
                            }
                        }
                    });
                });
            });
        </script>

