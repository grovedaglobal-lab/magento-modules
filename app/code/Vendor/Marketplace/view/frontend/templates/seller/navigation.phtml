<?php
/** @var $block \Vendor\Marketplace\Block\Seller\Navigation */
// Manually defining menu items with Icons for the clone
$menuItems = [
    ['label' => 'Dashboard', 'url' => 'marketplace/seller/dashboard', 'icon' => 'fa-tachometer-alt'],
    ['label' => 'Orders', 'url' => 'marketplace/order/history', 'icon' => 'fa-dollar-sign'],
    ['label' => 'Products', 'url' => 'marketplace/product/index', 'icon' => 'fa-box'],
    ['label' => 'Coupons', 'url' => 'marketplace/coupon/index', 'icon' => 'fa-ticket-alt'],
    ['label' => 'Coupon Report', 'url' => 'marketplace/report/coupon', 'icon' => 'fa-chart-line'],
    ['label' => 'Earnings', 'url' => 'marketplace/report/earnings', 'icon' => 'fa-chart-pie'],
    ['label' => 'Review', 'url' => 'marketplace/review/index', 'icon' => 'fa-star'],
    ['label' => 'Tickets', 'url' => 'sellerticket/ticket/index', 'icon' => 'fa-headset'],
    ['label' => 'Admin News', 'url' => 'marketplace/news/list', 'icon' => 'fa-newspaper'],
    ['label' => 'Shipping', 'url' => 'marketplace/shipping/index', 'icon' => 'fa-truck'],
    // --- Vendor Ads ---
    ['label' => 'My Advertisements', 'url' => 'vendor_ads/vendor/index', 'icon' => 'fa-bullhorn'],
    ['label' => 'Ad Performance', 'url' => 'vendor_ads/vendor/report', 'icon' => 'fa-chart-bar'],
    ['label' => 'Ad Wallet', 'url' => 'vendor_ads/vendor/wallet', 'icon' => 'fa-wallet'],
    ['label' => 'Recharge History', 'url' => 'vendor_ads/vendor/wallethistory', 'icon' => 'fa-history'],
    // ------------------
];

// Profile sub-menu items (Settings sub-options)
$profileSubItems = [
    ['label' => 'Profile Information', 'tab' => 'profile-info', 'icon' => 'fa-user-edit'],
    ['label' => 'Business Information', 'tab' => 'business-info', 'icon' => 'fa-briefcase'],
    ['label' => 'Vendor Documents', 'tab' => 'vendor-docs', 'icon' => 'fa-file-contract'],
    ['label' => 'Organic Certification', 'tab' => 'organic-cert', 'icon' => 'fa-leaf'],
    ['label' => 'Social Media Links', 'tab' => 'social-media', 'icon' => 'fa-share-alt'],
    ['label' => 'COA Report', 'tab' => 'coa-report', 'icon' => 'fa-file-alt'],
];

$isOnProfilePage = strpos($block->getRequest()->getPathInfo(), '/marketplace/seller/profile') !== false;
$activeTab = $block->getRequest()->getParam('tab', 'profile-info');
?>
<div class="block account-nav">
    <div class="content">
        <nav class="account-nav-content">
            <ul class="nav items">
                <?php foreach ($menuItems as $item): ?>
                    <?php
                    $isCurrent = $block->getRequest()->getFullActionName() == 'vendor_marketplace_seller_dashboard' && strpos($item['url'], 'dashboard') !== false;
                    // Simple active check logic for now, can be improved
                    if (strpos($block->getUrl($item['url']), $block->getRequest()->getPathInfo()) !== false) {
                        $isCurrent = true;
                    }
                    ?>
                    <li class="nav item <?= $isCurrent ? 'current' : '' ?>">
                        <a href="<?= $block->getUrl($item['url']) ?>">
                            <i class="fas <?= $item['icon'] ?>"></i>
                            <span class="nav-label"><?= $item['label'] ?></span>
                        </a>
                    </li>
                <?php endforeach; ?>

                <!-- Settings with Sub-Menu -->
                <li class="nav item nav-has-submenu <?= $isOnProfilePage ? 'current open' : '' ?>" id="nav-settings-item">
                    <a href="<?= $block->getUrl('marketplace/seller/profile') ?>" class="nav-parent-link" id="nav-settings-toggle">
                        <i class="fas fa-cog"></i>
                        <span class="nav-label">Settings</span>
                        <i class="fas fa-chevron-down nav-arrow <?= $isOnProfilePage ? 'rotated' : '' ?>"></i>
                    </a>
                    <ul class="nav-submenu <?= $isOnProfilePage ? 'open' : '' ?>">
                        <?php foreach ($profileSubItems as $subItem): ?>
                            <?php $isSubCurrent = $isOnProfilePage && $activeTab === $subItem['tab']; ?>
                            <li class="nav-submenu-item <?= $isSubCurrent ? 'current' : '' ?>">
                                <a href="<?= $block->getUrl('marketplace/seller/profile') ?>?tab=<?= $subItem['tab'] ?>">
                                    <i class="fas <?= $subItem['icon'] ?>"></i>
                                    <span><?= $block->escapeHtml(__($subItem['label'])) ?></span>
                                </a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
require(['jquery'], function ($) {
    'use strict';

    // Toggle submenu on parent click
    $('#nav-settings-toggle').on('click', function (e) {
        var $parent = $(this).closest('.nav-has-submenu');
        var $submenu = $parent.find('.nav-submenu');
        var $arrow = $(this).find('.nav-arrow');

        // If clicking a link that is already open, allow navigation
        if ($parent.hasClass('open') && <?= $isOnProfilePage ? 'true' : 'false' ?>) {
            return true; // allow navigation
        }

        e.preventDefault();
        $parent.toggleClass('open');
        $submenu.toggleClass('open');
        $arrow.toggleClass('rotated');
    });
});
</script>