<script>
    require(['jquery', 'mage/template'], function ($, mageTemplate) {
        'use strict';

        var docIndex = 0;
        var docRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required /></td>' +
            '<td>' +
            '<select name="new_documents[<%- data.index %>][type]" class="select shadow-xs">' +
            '<option value="id_proof"><?= $block->escapeJs(__('ID Proof')) ?></option>' +
            '<option value="address_proof"><?= $block->escapeJs(__('Address Proof')) ?></option>' +
            '<option value="business_license"><?= $block->escapeJs(__('Business License')) ?></option>' +
            '<option value="tax_document"><?= $block->escapeJs(__('Tax Document')) ?></option>' +
            '<option value="other"><?= $block->escapeJs(__('Other')) ?></option>' +
            '</select>' +
            '</td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" class="input-file" required />' +
            '</td>' +
            '<td class="text-center">' +
            '<button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>">' +
            '<i class="fas fa-trash"></i>' +
            '</button>' +
            '</td>' +
            '</tr>'
        );

        var organicRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required placeholder="<?= $block->escapeJs(__('e.g. NPOP Organic')) ?>" />' +
            '<input type="hidden" name="new_documents[<%- data.index %>][type]" value="organic_certification" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][certificate_number]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Cert. No.')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][issuer]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('e.g. APEDA')) ?>" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" class="input-file" required />' +
            '</td>' +
            '<td class="text-center">' +
            '<button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>">' +
            '<i class="fas fa-trash"></i>' +
            '</button>' +
            '</td>' +
            '</tr>'
        );

        var coaRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required placeholder="<?= $block->escapeJs(__('e.g. Batch COA-01')) ?>" />' +
            '<input type="hidden" name="new_documents[<%- data.index %>][type]" value="coa_report" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][certificate_number]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Report No.')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][issuer]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('e.g. Lab XYZ')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][product_name]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Product Name')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][product_desc]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Product Description')) ?>" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" class="input-file" required />' +
            '</td>' +
            '<td class="text-center">' +
            '<button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>">' +
            '<i class="fas fa-trash"></i>' +
            '</button>' +
            '</td>' +
            '</tr>'
        );

        $('#add-document-btn').on('click', function () {
            var progressData = {
                index: docIndex++
            };
            $('#new-documents-body').append(docRowTemplate({
                data: progressData
            }));
        });

        $('#add-organic-btn').on('click', function () {
            var progressData = {
                index: docIndex++
            };
            $('#new-organic-body').append(organicRowTemplate({
                data: progressData
            }));
        });

        // Add row for COA Reports
        $('#add-coa-btn').on('click', function () {
            $('#new-coa-container').removeClass('hidden');
            var data = { index: docIndex++ };
            $('#new-coa-body').append(coaRowTemplate({ data: data }));
        });

        // Remove Document Row
        $(document).on('click', '.remove-doc-row', function () {
            var index = $(this).data('index');
            $('#new-doc-row-' + index).remove();
        });
    });
</script>