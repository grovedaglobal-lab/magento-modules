<script>
    require(['jquery', 'mage/template'], function ($, mageTemplate) {
        'use strict';

        var docIndex = 0;
        var MAX_FILE_SIZE = 1 * 1024 * 1024; // 1 MB

        /* ------------------------------------------------------------------
         * showNotice(type, message)
         * Injects into Magento's .page.messages block (the existing theme
         * notification area) so the error looks identical to server messages.
         * type = 'error' | 'success' | 'notice'
         * ------------------------------------------------------------------ */
        function showNotice(type, message) {
            var $container = $('.page.messages');
            if (!$container.length) {
                // Fallback: create one at top of profile container
                $container = $('<div class="page messages"></div>')
                    .prependTo('.vendor-profile-container');
            }

            var $msg = $(
                '<div class="messages">' +
                '<div class="message message-' + type + ' ' + type + '" role="alert">' +
                '<div>' + message + '</div>' +
                '</div></div>'
            );

            $container.html($msg);
            $('html, body').animate({ scrollTop: $container.offset().top - 90 }, 250);

            // Auto-dismiss after 6 seconds
            setTimeout(function () { $msg.fadeOut(400, function () { $(this).remove(); }); }, 6000);
        }

        /* ------------------------------------------------------------------
         * clearNotices()  – remove any pending notices before re-validating
         * ------------------------------------------------------------------ */
        function clearNotices() {
            $('.vendor-profile-container .page.messages').empty();
        }

        /* ------------------------------------------------------------------
         * validateDocFile(input)
         * Rules: PDF only · max 1 MB
         * Returns: { valid: bool, message: string|null }
         * ------------------------------------------------------------------ */
        function validateDocFile(input) {
            var $input = $(input);
            var $hint  = $input.siblings('.doc-file-hint');

            // Reset previous inline state
            $input.removeClass('mage-error');
            $hint.removeClass('doc-file-hint-error').addClass('doc-file-hint');

            if (!input.files || !input.files.length) {
                return { valid: true, message: null };
            }

            var file   = input.files[0];
            var isPdf  = (file.type === 'application/pdf') ||
                          file.name.toLowerCase().slice(-4) === '.pdf';
            var underLimit = file.size <= MAX_FILE_SIZE;

            if (!isPdf) {
                $input.val('').addClass('mage-error');
                $hint.removeClass('doc-file-hint').addClass('doc-file-hint-error')
                     .text('<?= $block->escapeJs(__('Only PDF files are accepted.')) ?>');
                return {
                    valid: false,
                    message: '&#xe600; <strong>' + $input.closest('tr').find('input[type=text]').first().val() + '</strong> — <?= $block->escapeJs(__('Only PDF files are accepted.')) ?>'
                };
            }

            if (!underLimit) {
                var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                $input.val('').addClass('mage-error');
                $hint.removeClass('doc-file-hint').addClass('doc-file-hint-error')
                     .text('<?= $block->escapeJs(__('File size')) ?>: ' + sizeMB + ' MB — <?= $block->escapeJs(__('Exceeds the 1 MB limit.')) ?>');
                return {
                    valid: false,
                    message: '&#xe600; <strong>' + (file.name || '<?= $block->escapeJs(__('File')) ?>') + '</strong> (' + sizeMB + ' MB) — <?= $block->escapeJs(__('Maximum allowed size is 1 MB. Please compress or split the document.')) ?>'
                };
            }

            // Mark as valid
            $hint.removeClass('doc-file-hint-error').addClass('doc-file-hint')
                 .text('<?= $block->escapeJs(__('PDF only · max 1 MB')) ?>');
            return { valid: true, message: null };
        }

        /* ------------------------------------------------------------------
         * Live validation on file select
         * ------------------------------------------------------------------ */
        $(document).on('change', '.input-file', function () {
            clearNotices();
            var result = validateDocFile(this);
            if (!result.valid) {
                showNotice('error', result.message);
            }
        });

        /* ------------------------------------------------------------------
         * Block form submit if any file has an error
         * ------------------------------------------------------------------ */
        $(document).on('submit', '#form-vendor-docs, #form-organic-cert, #form-coa-report', function (e) {
            clearNotices();
            var errors = [];
            $(this).find('.input-file').each(function () {
                var result = validateDocFile(this);
                if (!result.valid) { errors.push(result.message); }
            });

            if (errors.length) {
                e.preventDefault();
                var summary = errors.length === 1
                    ? errors[0]
                    : '<?= $block->escapeJs(__('Please fix the following file errors:')) ?><ul style="margin:8px 0 0 16px">' +
                      errors.map(function(m){ return '<li>' + m + '</li>'; }).join('') +
                      '</ul>';
                showNotice('error', summary);
            }
        });

        /* ------------------------------------------------------------------
         * Row Templates  (accept=".pdf" + aria label added)
         * ------------------------------------------------------------------ */
        var docRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required /></td>' +
            '<td><select name="new_documents[<%- data.index %>][type]" class="select shadow-xs">' +
            '<option value="id_proof"><?= $block->escapeJs(__('ID Proof')) ?></option>' +
            '<option value="address_proof"><?= $block->escapeJs(__('Address Proof')) ?></option>' +
            '<option value="business_license"><?= $block->escapeJs(__('Business License')) ?></option>' +
            '<option value="tax_document"><?= $block->escapeJs(__('Tax Document')) ?></option>' +
            '<option value="other"><?= $block->escapeJs(__('Other')) ?></option>' +
            '</select></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" accept=".pdf" class="input-file" required />' +
            '<div class="doc-file-hint"><?= $block->escapeJs(__('PDF only · max 1 MB')) ?></div>' +
            '</td>' +
            '<td class="text-center"><button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>"><i class="fas fa-trash"></i></button></td>' +
            '</tr>'
        );

        var organicRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required placeholder="<?= $block->escapeJs(__('e.g. NPOP Organic')) ?>" />' +
            '<input type="hidden" name="new_documents[<%- data.index %>][type]" value="organic_certification" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][certificate_number]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Cert. No.')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][issuer]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('e.g. APEDA')) ?>" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" accept=".pdf" class="input-file" required />' +
            '<div class="doc-file-hint"><?= $block->escapeJs(__('PDF only · max 1 MB')) ?></div>' +
            '</td>' +
            '<td class="text-center"><button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>"><i class="fas fa-trash"></i></button></td>' +
            '</tr>'
        );

        var coaRowTemplate = mageTemplate(
            '<tr id="new-doc-row-<%- data.index %>">' +
            '<td><input type="text" name="new_documents[<%- data.index %>][label]" class="input-text shadow-xs" required placeholder="<?= $block->escapeJs(__('e.g. Batch COA-01')) ?>" />' +
            '<input type="hidden" name="new_documents[<%- data.index %>][type]" value="coa_report" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][certificate_number]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Report No.')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][issuer]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('e.g. Lab XYZ')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][product_name]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Product Name')) ?>" /></td>' +
            '<td><input type="text" name="new_documents[<%- data.index %>][product_desc]" class="input-text shadow-xs" placeholder="<?= $block->escapeJs(__('Product Description')) ?>" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][registration_date]" class="input-text shadow-xs" /></td>' +
            '<td><input type="date" name="new_documents[<%- data.index %>][expiry_date]" class="input-text shadow-xs" /></td>' +
            '<td>' +
            '<input type="hidden" name="new_documents[<%- data.index %>][file_id]" value="new_document_file_<%- data.index %>" />' +
            '<input type="file" name="new_document_file_<%- data.index %>" accept=".pdf" class="input-file" required />' +
            '<div class="doc-file-hint"><?= $block->escapeJs(__('PDF only · max 1 MB')) ?></div>' +
            '</td>' +
            '<td class="text-center"><button type="button" class="tool-btn delete remove-doc-row" data-index="<%- data.index %>"><i class="fas fa-trash"></i></button></td>' +
            '</tr>'
        );

        // Bind buttons
        $('#add-document-btn').on('click', function () {
            $('#new-documents-body').append(docRowTemplate({ data: { index: docIndex++ } }));
        });

        $('#add-organic-btn').on('click', function () {
            $('#new-organic-body').append(organicRowTemplate({ data: { index: docIndex++ } }));
        });

        $('#add-coa-btn').on('click', function () {
            $('#new-coa-container').removeClass('hidden');
            $('#new-coa-body').append(coaRowTemplate({ data: { index: docIndex++ } }));
        });

        // Remove row
        $(document).on('click', '.remove-doc-row', function () {
            $('#new-doc-row-' + $(this).data('index')).remove();
        });

        // Toggle label update for social media
        $(document).on('change', '.toggle-switch input[type="checkbox"]', function () {
            var $label = $(this).closest('.social-input-row').find('.toggle-label');
            $label.text(this.checked ? '<?= $block->escapeJs(__('Active')) ?>' : '<?= $block->escapeJs(__('Inactive')) ?>');
        });
    });
</script>